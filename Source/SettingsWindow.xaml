    <ScrollViewer x:Name="ProfilesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Every mood. Its own mix." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Save wheel layouts for gaming, streaming, music, and work." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,28"/><Border CornerRadius="14" Background="#1C1825" Padding="24"><StackPanel><TextBlock Text="ACTIVE PROFILE" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile,Mode=TwoWay}" AutomationProperties.Name="Active profile"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ActiveProfile.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Profile name"/><WrapPanel Margin="0,20,0,0"><Button Content="＋ New profile" Click="NewProfile"/><Button Content="Duplicate layout" Click="DuplicateProfile"/><Button Content="Remove profile" Click="RemoveProfile"/><Button Content="Export profile" Click="ExportProfile"/><Button Content="Export all" Click="ExportAllProfiles"/><Button Content="Import profiles" Click="ImportProfiles"/></WrapPanel><TextBlock Text="Each profile remembers its wheels, order, names, colors, and channel bindings. Switching layouts does not change mixer volumes." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></Border><Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutomaticProfilesEnabled}" Content="Switch profiles with the focused app"/><TextBlock Text="{Binding AutomaticProfileStatus}" Foreground="#D9B7EE" TextWrapping="Wrap" Margin="0,15,0,8"/><TextBlock Text="APP EXECUTABLES FOR THIS PROFILE" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProfileApplicationsBox" Text="{Binding ActiveProfile.Applications,UpdateSourceTrigger=PropertyChanged}" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2048" AutomationProperties.Name="Apps that activate this profile"/><Button Content="Browse for app…" Click="AddProfileApp" HorizontalAlignment="Left" Margin="0,12,0,14"/><TextBlock Text="Use names such as game.exe, obs64.exe. Separate them with commas. The first matching profile wins. Unmatched apps restore your last manual layout; a manual switch takes priority until focus changes." Foreground="#998AA7" TextWrapping="Wrap"/><TextBlock Text="Profile exports include names, colors, bindings, volume limits, and app rules. Live volume and mute values are excluded. Imports add profiles and never overwrite existing layouts." Foreground="#82738F" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PlacementPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Right where you need it." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Choose an edge, display, position, and breathing room." Foreground="#998AA7" Margin="0,12,0,24"/><Border CornerRadius="14" Background="#1C1825" Padding="24"><StackPanel><TextBlock Text="SCREEN EDGE" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Edges}" SelectedItem="{Binding ScreenEdge,Mode=TwoWay}" AutomationProperties.Name="Screen edge"/><TextBlock Text="DISPLAY" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Monitors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MonitorId,Mode=TwoWay}" AutomationProperties.Name="Display"/><TextBlock Text="POSITION ALONG EDGE" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="100" Value="{Binding PositionPercent}" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Position along edge"/><TextBlock Text="Start  ←  Center  →  End" Foreground="#998AA7" FontSize="11" Margin="0,8,0,12"/><TextBlock Text="SPACE BETWEEN WHEELS" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="36" Value="{Binding WheelSpacing}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Wheel spacing"/><TextBlock Text="{Binding WheelSpacing,StringFormat={}{0} px}" Foreground="#998AA7" Margin="0,8,0,16"/><Button Content="Preview placement" Click="Preview" HorizontalAlignment="Left"/><TextBlock Text="The edge only reveals the overlay. Hover an actual wheel to adjust its volume." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
    <StackPanel x:Name="UpdatesPage" Visibility="Collapsed"><TextBlock Text="Keep your wheels fresh." FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding AppVersion,StringFormat=Installed version · {0}}" Foreground="#998AA7" Margin="0,12,0,24"/><Border CornerRadius="14" Background="#1C1825" Padding="24"><StackPanel><TextBlock Text="{Binding UpdateStatus}" FontSize="19" TextWrapping="Wrap"/><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdatesAutomatically}" Content="Notify me about updates" Margin="0,24,0,16"/><TextBlock Text="Checks the public GitHub release at launch and every six hours. Your wheel settings are never sent. Choose Download and install to fetch and verify the official Windows installer. Setup will open, WaveWheels will close, and configuration will reopen after installation. Your settings are preserved. Canceling Setup leaves the current version installed." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,0,0,24"/><ProgressBar x:Name="UpdateDownloadProgress" Height="5" Maximum="100" Value="{Binding UpdateProgress,Mode=OneWay}" Margin="0,0,0,20" Foreground="#C5AFF0" Background="#30283C" BorderThickness="0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InstallingUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" IsEnabled="{Binding CanCheckUpdates}" Click="CheckUpdates"/><Button x:Name="InstallUpdateButton" Content="Download and install" IsEnabled="{Binding CanInstallUpdate}" Click="InstallUpdate" Background="#C5AFF0" Foreground="#21172F" FontWeight="SemiBold"/><Button Content="Open release page" Click="OpenRelease"/><Button x:Name="CancelUpdateButton" Content="Cancel download" IsEnabled="{Binding InstallingUpdate}" Click="CancelUpdate"/></WrapPanel></Stac