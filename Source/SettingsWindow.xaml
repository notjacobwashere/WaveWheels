    <Grid ClipToBounds="True">
    <Grid x:Name="WheelsPage"><Grid.RowDefinitions><RowDefinition Height="98"/><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Wheels" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Configure wheel appearance, order, and audio controls." Foreground="#898093" FontSize="12" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="WHEELS" FontSize="9" Foreground="#8C829D" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="CountBox" Width="66" SelectedItem="{Binding DisplayWheelCount, Mode=TwoWay}" IsEnabled="{Binding Connected}" AutomationProperties.Name="Number of wheels"/></StackPanel></Grid>
     <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="STACK ORDER" Foreground="#9E91AE" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="  /  TOP → BOTTOM" Foreground="#5E556B" FontSize="9" VerticalAlignment="Center"/></StackPanel><Grid Grid.Column="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="SIZE" Foreground="#8E819D" FontSize="9" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="50" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WheelSizePercent}" Margin="13,0" VerticalAlignment="Center" AutomationProperties.Name="Wheel size"/><TextBlock Grid.Column="2" Text="{Binding WheelSizeLabel}" Foreground="#D0B5EB" FontSize="11" VerticalAlignment="Center" Width="39" TextAlignment="Right"/></Grid></Grid>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="1.12*"/></Grid.ColumnDefinitions>
      <DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0"><Button Content="＋  Add a wheel" IsEnabled="{Binding Connected}" Click="Add" Background="#272033" Foreground="#D9BFEF" BorderBrush="#4E3D60" Margin="0"/><TextBlock Text="{Binding WheelArrangementHint}" TextWrapping="Wrap" Foreground="#71677F" FontSize="10" Margin="0,11,0,0"/></StackPanel>
       <AdornerDecorator><ListBox x:Name="WheelList" ItemsSource="{Binding DisplayWheels}" SelectedItem="{Binding EditorWheel}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" PreviewKeyDown="ReorderKey" DragOver="DragOverWheel" DragLeave="DragLeaveWheel" Drop="DropWheel" AutomationProperties.Name="Wheel arrangement">
        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#E5DEF0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="12"><Grid><Border x:Name="SelectionStrip" Width="3" Background="{Binding Accent}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,15" Opacity="0"/><ContentPresenter Margin="4,4,8,4"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#24202D"/><Setter TargetName="Card" Property="BorderBrush" Value="#80638F"/><Setter TargetName="SelectionStrip" Property="Opacity" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6B586E"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Grid MinHeight="88"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions>
         <Border Background="Transparent" Tag="DragHandle" IsEnabled="{Binding DataContext.Connected,RelativeSource={RelativeSource AncestorType=ListBox}}" Cursor="SizeNS" ToolTip="Drag to reorder" AutomationProperties.Name="Drag wheel"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding OrderLabel}" Foreground="#776A85" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,8"/><TextBlock Text="⠿" Foreground="#A08BB1" FontSize="22" HorizontalAlignment="Center"/></StackPanel></Border>
         <Viewbox Grid.Column="1" Width="60" Height="60" IsHitTestVisible="False"><local:WheelControl Compact="True" UseMuteButton="{Binding DataContext.UseMuteButton,RelativeSource={RelativeSource AncestorType=ListBox}}" Wheel="{Binding}"/></Viewbox>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,6,0"><TextBlock Text="{Binding Name}" Foreground="#E5DEF0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Detail}" Foreground="#81768D" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/><TextBlock Text="{Binding VolumeLabel}" Foreground="{Binding Accent}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
         <StackPanel Grid.Column="3" IsEnabled="{Binding DataContext.Connected,RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center"><Button Content="↑" Tag="{Binding}" Click="RowUp" Padding="0,3" Margin="0,0,0,3" Background="Transparent" Foreground="#B8A6C7" AutomationProperties.Name="Move this wheel up"/><Button Content="↓" Tag="{Binding}" Click="RowDown" Padding="0,3" Margin="0" Background="Transparent" Foreground="#B8A6C7" AutomationProperties.Name="Move this wheel down"/></StackPanel>
        </Grid></DataTemplate></ListBox.ItemTemplate>
       </ListBox></AdornerDecorator>
      </DockPanel>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,7,0">
       <Border x:Name="WheelPreviewFrame" CornerRadius="14" BorderBrush="#3A2E45" BorderThickness="1" Background="#181520" Padding="16"><StackPanel><TextBlock Text="LIVE PREVIEW" Foreground="#998AA7" FontSize="10"/><Grid x:Name="WheelPreviewStage" ClipToBounds="True" Height="{Binding PreviewHeight}" Margin="0,8,0,0"><Viewbox x:Name="WheelPreviewViewport" MaxWidth="{Binding PreviewWidth}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="{Binding PreviewCanvasWidth}" Height="216"><local:WheelControl x:Name="SelectedPreview" Canvas.Left="48" Canvas.Top="48" Wheel="{Binding EditorWheel}" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}"/></Canvas></Viewbox></Grid><TextBlock Text="Scaled to fit the preview." Foreground="#82738F" FontSize="10" Margin="0,8,0,0"/></StackPanel></Border>
       <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="WHEEL SETTINGS" Foreground="#9C8AA9" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Remove wheel" IsEnabled="{Binding Connected}" Click="Remove" Background="Transparent" Foreground="#B48FA3" Padding="0,2" Margin="0" FontSize="10"/></Grid>
       <TextBlock Text="NAME" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding EditorWheel.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Wheel name"/>
       <TextBlock Text="COLOR" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/></Grid.ColumnDefinitions><UniformGrid Rows="1" Columns="6" VerticalAlignment="Center" Margin="0,0,14,0"><Button Tag="#36BBD3" Background="#36BBD3" Height="24" Padding="0" Click="SetColor" AutomationProperties.Name="Cyan accent"/><Button Tag="#DA5DAD" Background="#DA5DAD" Padding="0" Click="SetColor" AutomationProperties.Name="Pink accent"/><Button Tag="#A99AFF" Background="#A99AFF" Padding="0" Click="SetColor" AutomationProperties.Name="Violet accent"/><Button Tag="#63CEA4" Background="#63CEA4" Padding="0" Click="SetColor" AutomationProperties.Name="Mint accent"/><Button Tag="#F4B16F" Background="#F4B16F" Padding="0" Click="SetColor" AutomationProperties.Name="Amber accent"/><Button Tag="#F18D93" Background="#F18D93" Padding="0" Margin="0" Click="SetColor" AutomationProperties.Name="Coral accent"/></UniformGrid><TextBox Grid.Column="1" x:Name="ColorBox" Text="{Binding EditorWheel.Color,Mode=OneWay}" MaxLength="7" LostFocus="ApplyHex" KeyDown="ColorKey" FontSize="11" Padding="8,10" AutomationProperties.Name="Custom hex color"/></Grid>
       <StackPanel x:Name="WaveLinkBindingFields"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Connected}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
       <TextBlock Text="INPUT CHANNEL" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ChannelBox" IsEnabled="{Binding Connected}" ItemsSource="{Binding Channels}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorWheel.ChannelId,Mode=OneWay}" SelectionChanged="ChannelSelected" DropDownClosed="ChannelClosed" AutomationProperties.Name="Wave Link input channel"/>
       <TextBlock Text="MIX SCOPE" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MixBox" IsEnabled="{Binding Connected}" ItemsSource="{Binding MixChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorWheel.MixId,Mode=OneWay}" SelectionChanged="MixSelected" DropDownClosed="MixClosed" AutomationProperties.Name="Mix scope"/>
       </StackPanel>
       <TextBlock Text="MAXIMUM VOLUME" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding EditorWheel.MaximumVolumeLabel}" Foreground="#D9B7EE" FontSize="13"/><Slider x:Name="VolumeLimitSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding EditorWheel.MaximumVolumePercent}" AutomationProperties.Name="Maximum wheel volume" Margin="0,8,0,4"/><TextBlock Text="Applies to changes made in WaveWheels. Shared bindings use the lowest limit." Foreground="#82738F" FontSize="10" TextWrapping="Wrap"/>
       <Button Content="Restore defaults" Tag="Wheels" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,18,0,8"/><TextBlock Text="Resets this wheel’s name, color, and limit. Preserves its binding." Foreground="#82738F" FontSize="10" TextWrapping="Wrap"/><TextBlock Text="Click to mute. Enable a dedicated mute button in Settings." Foreground="#72667F" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,12"/>

    </StackPanel></ScrollViewer>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0"><TextBlock Text="Settings" FontSize="31" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Configure size, animation, and input behavior." Foreground="#898093" Margin="0,0,0,30"/>
     <Border Background="#1C1825" BorderBrush="#3C3048" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><Grid><TextBlock Text="Wheel size" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding WheelSizeLabel}" HorizontalAlignment="Right" Foreground="#D9B7EE" FontSize="23"/></Grid><Slider x:Name="WheelSizeSlider" Minimum="50" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WheelSizePercent}" Margin="0,22,0,10" AutomationProperties.Name="Overlay wheel size"/><Grid><TextBlock Text="50%" Foreground="#776787" FontSize="10"/><TextBlock Text="180%" Foreground="#776787" FontSize="10" HorizontalAlignment="Right"/></Grid><TextBlock Text="Scales the complete wheel. Large layouts fit the display automatically." Foreground="#998AA7" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></Border>
     <Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AnimateWheels}" Content="Toggle animations" AutomationProperties.Name="Animate wheels"/><TextBlock Text="Enable app and wheel animations. Respects Windows motion settings." Foreground="#998AA7" TextWrapping="Wrap" Margin="58,12,0,0"/></StackPanel></Border>
     <Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><CheckBox x:Name="UseMuteButtonToggle" Style="{StaticResource Switch}" IsChecked="{Binding UseMuteButton}" Content="Show a dedicated mute button" AutomationProperties.Name="Use dedicated mute button"/><TextBlock Text="When enabled, only the speaker button toggles mute; dragging adjusts volume. Otherwise, click the wheel to mute and scroll to adjust." Foreground="#998AA7" TextWrapping="Wrap" Margin="58,12,0,0"/></StackPanel></Border>
     <Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="Scroll controls" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ScrollStepLabel}" Foreground="#D9B7EE" Margin="0,14,0,6"/><Slider x:Name="ScrollStepSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ScrollStepPercent}" AutomationProperties.Name="Volume step per scroll notch"/><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScrollAccelerationEnabled}" Content="Accelerate fast scrolling" Margin="0,20,0,14"/><TextBlock Text="Disable acceleration for a consistent step size." Foreground="#998AA7" TextWrapping="Wrap"/><TextBlock Text="SHIFT PRECISION" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding ShiftStepLabel}" Foreground="#D9B7EE"/><Slider x:Name="ShiftStepSlider" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ShiftStepPercent}" AutomationProperties.Name="Shift precision increment" Margin="0,8,0,8"/><TextBlock Text="Hold Shift to use this larger step size." Foreground="#998AA7" TextWrapping="Wrap"/><CheckBox x:Name="ShowShiftMarkersToggle" Style="{StaticResource Switch}" IsChecked="{Binding ShowShiftMarkers}" Content="Show Shift increment dots" Margin="0,16,0,0"/><TextBlock Text="HIDE DELAY" Style="{StaticResource FieldLabel}"/><TextBlock Text="{Binding IdleLabel}" Foreground="#D9B7EE"/><Slider x:Name="HideDelaySlider" Minimum="500" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding IdleMilliseconds}" AutomationProperties.Name="Wheel hide delay" Margin="0,8,0,0"/></StackPanel></Border>
     <Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="Using the controls" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Scroll at the screen edge to open the wheels. Pause, then scroll over a wheel to adjust volume. Click to toggle mute." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
     <Button Content="↗  Preview wheels" Click="Preview" Background="#C5AFF0" Foreground="#21172F" HorizontalAlignment="Left" Margin="0,24,0,0"/>
     <Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="App blacklist" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Pause controls while a listed application is focused. Uses exact executable names." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,10,0,16"/><CheckBox x:Name="BlacklistEnabledToggle" Style="{StaticResource Switch}" IsChecked="{Binding ApplicationBlacklistEnabled}" Content="Enable app blacklist"/><TextBlock Text="{Binding BlacklistStatus}" Foreground="#D9B7EE" TextWrapping="Wrap" Margin="0,12,0,14"/><TextBlock Text="EXECUTABLE NAME · e.g. game.exe" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BlacklistAppBox" Text="{Binding NewBlacklistedApplication,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Blacklisted executable name"/><WrapPanel Margin="0,12,0,8"><Button Content="Add app" Click="AddBlacklistedApp"/><Button Content="Browse app" Click="BrowseBlacklistedApp"/><Button Content="Remove selected" Click="RemoveBlacklistedApp"/></WrapPanel><ListBox x:Name="BlacklistAppList" ItemsSource="{Binding BlacklistedApplications}" SelectedItem="{Binding SelectedBlacklistedApplication}" Height="110" Background="#1A1822" Foreground="#F3F0FA" BorderBrush="#393040" Padding="8" AutomationProperties.Name="Blacklisted applications"/></StackPanel></Border>
    <Button Content="Restore defaults" Tag="Settings" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Resets size, animations, input behavior, and blacklist settings." Foreground="#82738F" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
<Grid x:Name="EffectsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Effects" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Adjust glow, particles, motion, and colors." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,24"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><Border Background="#1C1825" CornerRadius="14" Padding="24" Margin="0,0,0,0"><StackPanel><TextBlock Text="Bloom intensity" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.BloomPercent}" AutomationProperties.Name="Bloom intensity"/><TextBlock Text="{Binding Effects.BloomPercent,StringFormat={}{0}%}" Foreground="#D9B7EE" Margin="0,8,0,10"/><TextBlock Text="Spark density" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.SparkCount}" AutomationProperties.Name="Spark density"/><TextBlock Text="{Binding Effects.SparkCount,StringFormat={}{0} sparks}" Foreground="#D9B7EE" Margin="0,8,0,10"/><TextBlock Text="Spark speed" Style="{StaticResource FieldLabel}"/><Slider Minimum="25" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Effects.SparkSpeedPercent}" AutomationProperties.Name="Spark speed"/><TextBlock Text="{Binding Effects.SparkSpeedPercent,StringFormat={}{0}%}" Foreground="#D9B7EE" Margin="0,8,0,10"/><TextBlock Text="Mute shake strength" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.ShakePercent}" AutomationProperties.Name="Mute shake strength"/><TextBlock Text="{Binding Effects.ShakePercent,StringFormat={}{0}%}" Foreground="#D9B7EE" Margin="0,8,0,10"/><TextBlock Text="Mute animation speed" Style="{StaticResource FieldLabel}"/><Slider Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Effects.MuteSpeedPercent}" AutomationProperties.Name="Mute animation speed"/><TextBlock Text="{Binding Effects.MuteSpeedPercent,StringFormat={}{0}%}" Foreground="#D9B7EE" Margin="0,8,0,10"/><TextBlock Text="Wheel surface" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Effects.NormalColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Wheel surface color"/><TextBlock Text="Muted wheel and label" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Effects.MutedColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Muted wheel and label color"/><TextBlock Text="Muted speaker button" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding Effects.MutedButtonColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Muted speaker button color"/><TextBlock Text="{Binding EffectColorStatus}" Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,12"/><TextBlock Text="Requires animations enabled in Settings. Respects Windows motion settings." Foreground="#998AA7" TextWrapping="Wrap"/></StackPanel></Border><Button Content="Restore defaults" Tag="Effects" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Resets effect settings and colors." Foreground="#82738F"/></StackPanel></ScrollViewer><Border Background="#181520" CornerRadius="14" Padding="12" Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0"><StackPanel><Viewbox MaxWidth="350" HorizontalAlignment="Center"><Canvas Width="396" Height="216"><local:WheelControl x:Name="EffectsDemo" Canvas.Left="48" Canvas.Top="48" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}"/></Canvas></Viewbox><WrapPanel HorizontalAlignment="Center"><Button Content="Play max effect" Click="PreviewMaxEffect"/><Button Content="Toggle preview mute" Click="PreviewMuteEffect"/></WrapPanel><TextBlock Text="Preview only. Does not affect audio." Foreground="#998AA7" TextAlignment="Center" Margin="0,10,0,8"/></StackPanel></Border></Grid></Grid>
    <ScrollViewer x:Name="ProfilesPage" IsEnabled="{Binding Connected}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Profiles" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Save layouts and assign them to applications." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,28"/><Border CornerRadius="14" Background="#1C1825" Padding="24"><StackPanel><TextBlock Text="ACTIVE PROFILE" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile,Mode=TwoWay}" AutomationProperties.Name="Active profile"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding ActiveProfile.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Profile name"/><WrapPanel Margin="0,20,0,0"><Button Content="＋ New profile" Click="NewProfile"/><Button Content="Duplicate layout" Click="DuplicateProfile"/><Button Content="Remove profile" Click="RemoveProfile"/><Button Content="Export profile" Click="ExportProfile"/><Button Content="Export all" Click="ExportAllProfiles"/><Button Content="Import profiles" Click="ImportProfiles"/></WrapPanel><TextBlock Text="Saves wheel appearance, order, and bindings. Switching profiles preserves audio levels." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,20,0,0"/></StackPanel></Border><Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutomaticProfilesEnabled}" Content="Switch profiles with the focused app"/><TextBlock Text="{Binding AutomaticProfileStatus}" Foreground="#D9B7EE" TextWrapping="Wrap" Margin="0,15,0,8"/><TextBlock Text="APP EXECUTABLES FOR THIS PROFILE" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ProfileApplicationsBox" Text="{Binding ActiveProfile.Applications,UpdateSourceTrigger=PropertyChanged}" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2048" AutomationProperties.Name="Apps that activate this profile"/><Button Content="Browse for app…" Click="AddProfileApp" HorizontalAlignment="Left" Margin="0,12,0,14"/><TextBlock Text="Enter executable names separated by commas. The first match applies. Unmatched apps restore the manual profile." Foreground="#998AA7" TextWrapping="Wrap"/><TextBlock Text="Exports include layout settings and app rules, excluding live audio levels. Imports add profiles without overwriting existing layouts." Foreground="#82738F" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></Border><Button Content="Restore defaults" Tag="Profiles" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Disables automatic switching and clears this profile’s app rules. Preserves layouts." Foreground="#82738F" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="PlacementPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Placement" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Set the display, screen edge, and wheel spacing." Foreground="#998AA7" Margin="0,12,0,24"/><Border CornerRadius="14" Background="#1C1825" Padding="24"><StackPanel><TextBlock Text="SCREEN EDGE" Style="{StaticResource FieldLabel}"/><ComboBox ItemsSource="{Binding Edges}" SelectedItem="{Binding ScreenEdge,Mode=TwoWay}" AutomationProperties.Name="Screen edge"/><TextBlock Text="DISPLAY" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="MonitorBox" ItemsSource="{Binding Monitors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MonitorId,Mode=OneWay}" SelectionChanged="MonitorSelected" DropDownClosed="MonitorClosed" AutomationProperties.Name="Display"/><TextBlock Text="POSITION ALONG EDGE" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="100" Value="{Binding PositionPercent}" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Position along edge"/><TextBlock Text="Start  ←  Center  →  End" Foreground="#998AA7" FontSize="11" Margin="0,8,0,12"/><TextBlock Text="DISTANCE FROM SCREEN EDGE" Style="{StaticResource FieldLabel}"/><Slider x:Name="EdgeDistanceSlider" Minimum="0" Maximum="200" Value="{Binding EdgeDistance}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Distance from screen edge"/><TextBlock Text="{Binding EdgeDistance,StringFormat={}{0} px}" Foreground="#998AA7" Margin="0,8,0,16"/><TextBlock Text="SPACE BETWEEN WHEELS" Style="{StaticResource FieldLabel}"/><Slider Minimum="0" Maximum="36" Value="{Binding WheelSpacing}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Wheel spacing"/><TextBlock Text="{Binding WheelSpacing,StringFormat={}{0} px}" Foreground="#998AA7" Margin="0,8,0,16"/><Button Content="Preview placement" Click="Preview" HorizontalAlignment="Left"/><TextBlock Text="Edge scrolling opens the controls. Scroll over a wheel to adjust volume." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel></Border><Button Content="Restore defaults" Tag="Placement" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Resets display, edge, position, distance, and spacing." Foreground="#82738F" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Updates" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="{Binding AppVersion,StringFormat=Installed version · {0}}" Foreground="#998AA7" Margin="0,12,0,24"/><Border CornerRadius="14" Background="#1C1825" Padding="24"><StackPanel><TextBlock Text="UPDATE CHANNEL" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UpdateChannelPicker" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" IsEnabled="{Binding CanCheckUpdates}" AutomationProperties.Name="Update channel"/><TextBlock Text="Stable includes official releases. Beta also includes prereleases." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,22"/><TextBlock Text="{Binding UpdateStatus}" FontSize="19" TextWrapping="Wrap"/><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdatesAutomatically}" Content="Notify me about updates" Margin="0,24,0,16"/><TextBlock Text="Checks GitHub at launch and every six hours. Verified updates restart the app and preserve settings." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,0,0,24"/><ProgressBar x:Name="UpdateDownloadProgress" Height="5" Maximum="100" Value="{Binding UpdateProgress,Mode=OneWay}" Margin="0,0,0,20" Foreground="#C5AFF0" Background="#30283C" BorderThickness="0"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding InstallingUpdate}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar><WrapPanel><Button x:Name="CheckUpdatesButton" Content="Check for updates" IsEnabled="{Binding CanCheckUpdates}" Click="CheckUpdates"/><Button x:Name="InstallUpdateButton" Content="Download and install" IsEnabled="{Binding CanInstallUpdate}" Click="InstallUpdate" Background="#C5AFF0" Foreground="#21172F" FontWeight="SemiBold"/><Button Content="Open release page" Click="OpenRelease"/><Button x:Name="CancelUpdateButton" Content="Cancel download" IsEnabled="{Binding InstallingUpdate}" Click="CancelUpdate"/></WrapPanel></StackPanel></Border><Border CornerRadius="14" Background="#1C1825" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="Back to stable" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding StableReleaseLabel}" Foreground="#D9B7EE" Margin="0,12,0,10"/><TextBlock Text="Installs the latest stable release, including older versions. Preserves settings and switches future checks to Stable." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,0,0,16"/><Button x:Name="InstallStableButton" Content="Install latest stable" IsEnabled="{Binding CanInstallStable}" Click="InstallStable" HorizontalAlignment="Left"/></StackPanel></Border><Border CornerRadius="14" Background="#1C1825" Padding="24" Margin="0,18,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding BetaChannelEnabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="Beta archive" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Install a published beta, including older builds. Settings are preserved; older builds may not support newer options." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,18"/><ListBox x:Name="BetaBuildList" ItemsSource="{Binding BetaBuilds}" SelectedItem="{Binding SelectedBetaBuild}" IsEnabled="{Binding CanCheckUpdates}" Height="160" Background="#1A1822" Foreground="#F3F0FA" BorderBrush="#393040" Padding="8" AutomationProperties.Name="Published beta builds"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Version,StringFormat=Beta · {0}}" Padding="8"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Check for updates to refresh available builds." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,12,0,14"/><WrapPanel><Button x:Name="InstallBetaButton" Content="Install selected beta" IsEnabled="{Binding CanInstallBeta}" Click="InstallBeta" Background="#C5AFF0" Foreground="#21172F"/><Button Content="View beta release" Click="OpenBetaRelease"/></WrapPanel></StackPanel></Border><Button Content="Restore defaults" Tag="Updates" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Restores Stable and automatic notifications." Foreground="#82738F" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    <StackPanel x:Name="StartupPage" Visibility="Collapsed"><TextBlock Text="Startup" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Control automatic launch at Windows sign-in." Foreground="#898093" Margin="0,10,0,30"/><Border Background="#1B1822" BorderBrush="#3A2E43" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupEnabled}" Content="Start at Windows sign-in" AutomationProperties.Name="Start with Windows"/><TextBlock Text="{Binding StartupDescription}" Foreground="#998AA7" TextWrapping="Wrap" Margin="58,12,0,0"/></StackPanel></Border><TextBlock Text="The app starts in the system tray. Click its icon to open configuration." Foreground="#82738F" TextWrapping="Wrap" Margin="0,26,0,0"/><Button Content="Restore defaults" Tag="Startup" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Disables launch at sign-in." Foreground="#82738F" TextWrapping="Wrap"/></StackPanel>
    <ScrollViewer x:Name="ConnectionPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel><TextBlock Text="Connection" FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Manage the local Wave Link connection." Foreground="#898093" Margin="0,10,0,30"/><Border Background="#1B1822" BorderBrush="#3A2E43" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/><TextBlock Text="{Binding ChannelCount}" Foreground="#998AA7" Margin="0,10,0,22"/><TextBlock Text="LOCAL PORT OVERRIDE" Style="{StaticResource FieldLabel}"/><TextBox Text="{Binding PortText,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Local port override"/><TextBlock Text="Leave blank for automatic discovery." Foreground="#82738F" FontSize="12" Margin="0,10,0,20"/><TextBlock Text="{Binding WindowsAudioStatus}" Foreground="#F4B16F" TextWrapping="Wrap" Margin="0,0,0,16"/><WrapPanel><Button x:Name="StartWaveLinkButton" Content="Find and start Wave Link" Click="FindAndStartWaveLink"/><Button Content="Locate Wave Link…" Click="LocateWaveLink"/></WrapPanel><TextBlock Text="Finds desktop and Store installations. Select WaveLink.exe manually if needed." Foreground="#998AA7" TextWrapping="Wrap" Margin="0,8,0,18"/><Button Content="Reconnect Wave Link" HorizontalAlignment="Left" Click="Reconnect" Background="#C5AFF0" Foreground="#21172F"/></StackPanel></Border><TextBlock Text="Windows Audio is used while disconnected. Your saved channel wheels return on connection. Volume and mute stay independent." Foreground="#82738F" TextWrapping="Wrap" Margin="0,26,0,0"/><Button Content="Restore defaults" Tag="Connection" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8"/><TextBlock Text="Restores automatic port discovery and reconnects." Foreground="#82738F" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
