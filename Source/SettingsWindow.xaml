    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock Text="CONFIGURATION" Foreground="#625A70" FontSize="9" FontWeight="SemiBold" Margin="12,0,0,13"/><Button x:Name="WheelsNav" Style="{StaticResource NavButton}" Content="◉   Wheels" Tag="Wheels" Background="#272132" Foreground="#DFC9FF" Click="Navigate"/><Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigate"/><Button x:Name="EffectsNav" Style="{StaticResource NavButton}" Content="✦   Effects" Tag="Effects" Click="Navigate"/><Button x:Name="ProfilesNav" IsEnabled="{Binding Connected}" Style="{StaticResource NavButton}" Content="▤   Profiles" Tag="Profiles" Click="Navigate"/><Button x:Name="PlacementNav" Style="{StaticResource NavButton}" Content="⌖   Placement" Tag="Placement" Click="Navigate"/><Border Height="1" Background="#25212E" Margin="10,12,10,12"/><TextBlock Text="APPLICATION" Foreground="#625A70" FontSize="9" FontWeight="SemiBold" Margin="12,0,0,13"/><Button x:Name="StartupNav" Style="{StaticResource NavButton}" Content="↗   Startup" Tag="Startup" Click="Navigate"/><Button x:Name="UpdatesNav" Style="{StaticResource NavButton}" Content="↻   Updates" Tag="Updates" Click="Navigate"/><Button x:Name="ConnectionNav" Style="{StaticResource NavButton}" Content="⌁   Connection" Tag="Connection" Click="Navigate"/></StackPanel></ScrollViewer>
