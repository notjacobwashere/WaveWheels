<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WaveWheels" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaveWheels.SettingsWindow" Icon="/WaveWheels;component/Assets/WaveWheels.ico" Title="Wave Wheels" Width="1160" Height="860" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#0D141C" Foreground="#E9F0F5" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border local:InterfaceMotion.Enabled="{Binding InterfaceAnimationsEnabled}" BorderBrush="#293A49" BorderThickness="1" CornerRadius="14" Background="#101820">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="*" />
        <RowDefinition Height="38" />
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="Transparent" BorderBrush="#24323F" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
        <Grid Margin="20,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderAppIcon" Source="/WaveWheels;component/Assets/WaveWheels.ico" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Grid.Column="1" Text="Wave Wheels" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="−" Width="44" Height="38" FontSize="20" Padding="0" Margin="0,0,4,0" Background="Transparent" Click="Minimize" AutomationProperties.Name="Minimize" />
            <Button Content="×" Width="44" Height="38" FontSize="22" Padding="0" Margin="0" Background="Transparent" Click="HideConfig" ToolTip="Close configuration" AutomationProperties.Name="Close configuration" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#0C1219" BorderBrush="#24323F" BorderThickness="0,0,1,0">
          <DockPanel Margin="12,22,12,16">
            <StackPanel DockPanel.Dock="Bottom">
              <Border x:Name="AudioModeBanner" Background="#151E27" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                  <TextBlock Text="Audio source" Foreground="#8596A6" FontSize="10" />
                  <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ModeAccent}" FontSize="11" FontWeight="SemiBold" Margin="0,6,0,8" />
                  <Button Content="Manage connection" Tag="Connection" Click="Navigate" Padding="0,4" Background="Transparent" Foreground="#A6B5C2" HorizontalAlignment="Left" FontSize="11" />
                </StackPanel>
              </Border>
              <Button x:Name="PreviewToggleButton" Content="{Binding PreviewButtonLabel}" Click="Preview" Margin="0,0,0,8">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="#243D3C" />
                    <Setter Property="Foreground" Value="#A3E6D9" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                        <Setter Property="Background" Value="#73DCC8" />
                        <Setter Property="Foreground" Value="#10231F" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button x:Name="ReportProblemButton" Content="Report a problem" Click="ReportProblem" Background="Transparent" Foreground="#98AABC" Padding="10,8" Margin="0,0,0,4" />
              <Button Content="Setup guide" Click="OpenSetup" Background="Transparent" Foreground="#98AABC" Padding="10,8" Margin="0" />
              <TextBlock Text="{Binding AppVersionLabel}" Foreground="#667B8B" FontSize="10" Margin="12,14,0,0" />
            </StackPanel>
              <Button DockPanel.Dock="Top" x:Name="SearchSettingsButton" Content="Search settings" Click="OpenSettingsSearch" ToolTip="Search settings (Ctrl+K)" Padding="12,10" Margin="0,0,0,18" HorizontalContentAlignment="Left" Background="#182630" Foreground="#BBCAD4" />
            <StackPanel x:Name="PrimaryNavigation">
              <Button x:Name="WheelsNav" Content="Wheels" Tag="Wheels" Style="{StaticResource NavButton}" Click="Navigate" />
              <Button x:Name="EffectsNav" Content="Appearance" Tag="Effects" Style="{StaticResource NavButton}" Click="Navigate" />
              <Button x:Name="SettingsNav" Content="Settings" Tag="Settings" Style="{StaticResource NavButton}" Click="Navigate" />
              <Button x:Name="UpdatesNav" Content="Updates" Tag="Updates" Style="{StaticResource NavButton}" Click="Navigate" />
            </StackPanel>
          </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="28,22,28,20">
          <Border x:Name="SectionTabs" DockPanel.Dock="Top" Background="#0D151E" CornerRadius="9" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,22">
            <Grid>
              <StackPanel x:Name="WheelTabs" Orientation="Horizontal">
                <Button x:Name="WheelEditorTab" Content="Your wheels" Tag="Wheels" Style="{StaticResource SectionTab}" Click="Navigate" />
                <Button x:Name="ProfilesNav" Content="Profiles" Tag="Profiles" Style="{StaticResource SectionTab}" Click="Navigate" IsEnabled="{Binding Connected}" />
              </StackPanel>
              <StackPanel x:Name="AppearanceTabs" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="EffectsTab" Content="Effects" Tag="Effects" Style="{StaticResource SectionTab}" Click="Navigate" />
                <Button x:Name="PlacementNav" Content="Placement" Tag="Placement" Style="{StaticResource SectionTab}" Click="Navigate" />
              </StackPanel>
              <StackPanel x:Name="PreferenceTabs" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="ControlsTab" Content="Controls" Tag="Settings" Style="{StaticResource SectionTab}" Click="Navigate" />
                <Button x:Name="StartupNav" Content="Startup" Tag="Startup" Style="{StaticResource SectionTab}" Click="Navigate" />
                <Button x:Name="ConnectionNav" Content="Connection" Tag="Connection" Style="{StaticResource SectionTab}" Click="Navigate" />
              </StackPanel>
            </Grid>
          </Border>
          <Grid ClipToBounds="True">
            <Grid x:Name="WheelsPage">
              <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Wheels" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="Configure wheel appearance, order, and audio controls." Foreground="#98AABC" FontSize="12" Margin="0,7,0,20" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="UndoWheelDeletionButton" Content="↶  Undo deletion" Click="UndoWheelDeletion" IsEnabled="{Binding CanUndoWheelDeletion}" Padding="12,9" Margin="0,0,16,0" FontSize="12" ToolTip="Restore the most recently deleted wheel in this profile">
                    <Button.Style>
                      <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding CanUndoWheelDeletion}" Value="True">
                            <Setter Property="Background" Value="#73DCC8" />
                            <Setter Property="Foreground" Value="#10231F" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>
                  <TextBlock Text="Count" FontSize="9" Foreground="#8596A6" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" />
                  <Border x:Name="CountBox" IsEnabled="{Binding Connected}" Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="8" Padding="3" AutomationProperties.Name="Number of wheels">
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="DecreaseWheelCountButton" Content="−" Click="DecreaseWheelCount" Width="32" Height="32" Padding="0" Margin="0" FontSize="18" AutomationProperties.Name="Fewer wheels">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DisplayWheelCount}" Value="1">
                                <Setter Property="IsEnabled" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <TextBlock Text="{Binding DisplayWheelCount}" Width="38" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" />
                      <Button x:Name="IncreaseWheelCountButton" Content="+" Click="IncreaseWheelCount" Width="32" Height="32" Padding="0" Margin="0" FontSize="18" AutomationProperties.Name="More wheels">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding DisplayWheelCount}" Value="12">
                                <Setter Property="IsEnabled" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,0,0,16">
                <TextBlock Text="Your wheels" Foreground="#98AABC" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="1.12*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Button Content="＋  Add a wheel" IsEnabled="{Binding Connected}" Click="Add" Background="#1C2D39" Foreground="#BBCAD4" BorderBrush="#293A49" Margin="0" />
                    <TextBlock Text="{Binding WheelArrangementHint}" TextWrapping="Wrap" Foreground="#8095A5" FontSize="10" Margin="0,11,0,0" />
                  </StackPanel>
                  <AdornerDecorator>
                    <ListBox x:Name="WheelList" ItemsSource="{Binding DisplayWheels}" SelectedItem="{Binding EditorWheel}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" PreviewKeyDown="ReorderKey" DragOver="DragOverWheel" DragLeave="DragLeaveWheel" Drop="DropWheel" AutomationProperties.Name="Wheel arrangement">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Foreground" Value="#E9F0F5" />
                          <Setter Property="Margin" Value="0,0,0,10" />
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12">
                                  <Grid>
                                    <Border x:Name="SelectionStrip" Width="3" Background="{Binding Accent}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,15" Opacity="0" />
                                    <ContentPresenter Margin="4,4,8,4" />
                                  </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#1B3136" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#468C83" />
                                    <Setter TargetName="SelectionStrip" Property="Opacity" Value="1" />
                                  </Trigger>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#587A89" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid MinHeight="76">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="36" />
                              <ColumnDefinition Width="66" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Background="Transparent" Tag="DragHandle" IsEnabled="{Binding DataContext.Connected,RelativeSource={RelativeSource AncestorType=ListBox}}" Cursor="SizeNS" ToolTip="Drag to reorder" AutomationProperties.Name="Drag wheel">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderLabel}" Foreground="#8596A6" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="⠿" Foreground="#98AABC" FontSize="22" HorizontalAlignment="Center" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                            <Viewbox Grid.Column="1" Width="60" Height="60" IsHitTestVisible="False">
                              <local:WheelControl Compact="True" UseMuteButton="{Binding DataContext.UseMuteButton,RelativeSource={RelativeSource AncestorType=ListBox}}" Wheel="{Binding}" />
                            </Viewbox>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,6,0">
                              <TextBlock Text="{Binding Name}" Foreground="#E9F0F5" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Detail}" Foreground="#98AABC" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" IsEnabled="{Binding DataContext.Connected,RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center">
                              <Button Content="↑" Tag="{Binding}" Click="RowUp" Padding="0,3" Margin="0,0,0,3" Background="Transparent" Foreground="#98AABC" AutomationProperties.Name="Move this wheel up" />
                              <Button Content="↓" Tag="{Binding}" Click="RowDown" Padding="0,3" Margin="0" Background="Transparent" Foreground="#98AABC" AutomationProperties.Name="Move this wheel down" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </AdornerDecorator>
                </DockPanel>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <Border x:Name="WheelPreviewFrame" CornerRadius="14" BorderBrush="#293A49" BorderThickness="1" Background="#111B25" Padding="16" Margin="0,0,0,12">
                      <StackPanel>
                        <TextBlock Text="Preview" Foreground="#98AABC" FontSize="10" TextWrapping="Wrap" />
                        <Grid x:Name="WheelPreviewStage" ClipToBounds="True" Height="{Binding PreviewHeight}" Margin="0,8,0,0">
                          <Viewbox x:Name="WheelPreviewViewport" MaxWidth="{Binding PreviewWidth}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{Binding PreviewCanvasWidth}" Height="216">
                              <local:WheelControl x:Name="SelectedPreview" Canvas.Left="48" Canvas.Top="48" Wheel="{Binding EditorWheel}" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}" />
                            </Canvas>
                          </Viewbox>
                        </Grid>
                      </StackPanel>
                    </Border>
                    <Expander Header="Appearance" IsExpanded="True" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding EditorWheel.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Wheel name" />
                        <TextBlock Text="Color" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                          </Grid.ColumnDefinitions>
                          <UniformGrid Rows="1" Columns="6" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button Tag="#36BBD3" Background="#36BBD3" Height="24" Padding="0" Click="SetColor" AutomationProperties.Name="Cyan accent" />
                            <Button Tag="#DA5DAD" Background="#DA5DAD" Padding="0" Click="SetColor" AutomationProperties.Name="Pink accent" />
                            <Button Tag="#A99AFF" Background="#A99AFF" Padding="0" Click="SetColor" AutomationProperties.Name="Violet accent" />
                            <Button Tag="#63CEA4" Background="#63CEA4" Padding="0" Click="SetColor" AutomationProperties.Name="Mint accent" />
                            <Button Tag="#F4B16F" Background="#F4B16F" Padding="0" Click="SetColor" AutomationProperties.Name="Amber accent" />
                            <Button Tag="#F18D93" Background="#F18D93" Padding="0" Margin="0" Click="SetColor" AutomationProperties.Name="Coral accent" />
                          </UniformGrid>
                          <DockPanel Grid.Column="1">
                            <Button DockPanel.Dock="Right" Content=" " ToolTip="Choose color" AutomationProperties.Name="Choose custom hex color" Tag="Wheel" Click="PickColor" Width="34" Padding="0" Margin="6,0,0,0" Background="{Binding EditorWheel.Color}" BorderBrush="#587A89" BorderThickness="1" />
                            <TextBox x:Name="ColorBox" Text="{Binding EditorWheel.Color,Mode=OneWay}" MaxLength="7" FontSize="11" Padding="8,10" AutomationProperties.Name="Custom hex color" />
                          </DockPanel>
                        </Grid>
                        <Button Content="Apply color" Click="ApplyHex" HorizontalAlignment="Left" Margin="0,12,0,0" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Audio controls" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <StackPanel x:Name="WaveLinkBindingFields">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="Input channel" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                          <ComboBox x:Name="ChannelBox" IsEnabled="{Binding Connected}" ItemsSource="{Binding Channels}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorWheel.ChannelId,Mode=OneWay}" SelectionChanged="ChannelSelected" DropDownClosed="ChannelClosed" AutomationProperties.Name="Wave Link input channel" />
                          <TextBlock Text="Mix scope" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                          <ComboBox x:Name="MixBox" IsEnabled="{Binding Connected}" ItemsSource="{Binding MixChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorWheel.MixId,Mode=OneWay}" SelectionChanged="MixSelected" DropDownClosed="MixClosed" AutomationProperties.Name="Mix scope" />
                        </StackPanel>
                        <TextBlock Text="Maximum volume" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EditorWheel.MaximumVolumeLabel}" Foreground="#A3E6D9" FontSize="13" TextWrapping="Wrap" />
                        <Slider x:Name="VolumeLimitSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding EditorWheel.MaximumVolumePercent}" AutomationProperties.Name="Maximum wheel volume" Margin="0,8,0,4" />
                        <TextBlock Text="Applies to changes made in WaveWheels. Shared bindings use the lowest limit." Foreground="#8095A5" FontSize="10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <WrapPanel Margin="0,6,0,12">
                      <Button Content="Restore defaults" Tag="Wheels" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,0,8,0" Background="Transparent" Foreground="#98AABC" />
                      <Button Content="Remove wheel" IsEnabled="{Binding Connected}" Click="Remove" Background="#36232C" Foreground="#F1B8C4" Padding="16,10" MinHeight="38" Margin="0" FontSize="12" />
                    </WrapPanel>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Controls" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Configure wheel behavior and input." Foreground="#98AABC" Margin="0,7,0,20" />
                <Expander Header="Wheel size" IsExpanded="True" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <Grid>
                      <TextBlock Text="{Binding WheelSizeLabel}" HorizontalAlignment="Left" Foreground="#A3E6D9" FontSize="18" TextWrapping="Wrap" />
                    </Grid>
                    <Slider x:Name="WheelSizeSlider" Minimum="50" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WheelSizePercent}" Margin="0,22,0,10" AutomationProperties.Name="Overlay wheel size" />
                    <Grid>
                      <TextBlock Text="50%" Foreground="#8596A6" FontSize="10" TextWrapping="Wrap" />
                      <TextBlock Text="180%" Foreground="#8596A6" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="Scales the complete wheel. Large layouts fit the display automatically." Foreground="#98AABC" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Animations" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AnimateWheels}" IsEnabled="{Binding AnimationControlsEnabled}" Content="Toggle animations" AutomationProperties.Name="Animate wheels" />
                    <TextBlock Text="Enable app and wheel animations." Foreground="#98AABC" TextWrapping="Wrap" Margin="58,12,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Mute behavior" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <CheckBox x:Name="UseMuteButtonToggle" Style="{StaticResource Switch}" IsChecked="{Binding UseMuteButton}" Content="Show a dedicated mute button" AutomationProperties.Name="Use dedicated mute button" />
                    <TextBlock Text="When enabled, only the speaker button toggles mute; dragging adjusts volume. Otherwise, click the wheel to mute and scroll to adjust." Foreground="#98AABC" TextWrapping="Wrap" Margin="58,12,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Scroll and Shift steps" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Scroll controls" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScrollStepLabel}" Foreground="#A3E6D9" Margin="0,14,0,6" TextWrapping="Wrap" />
                    <Slider x:Name="ScrollStepSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ScrollStepPercent}" AutomationProperties.Name="Volume step per scroll notch" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScrollAccelerationEnabled}" Content="Accelerate fast scrolling" Margin="0,20,0,14" />
                    <TextBlock Text="Disable acceleration for a consistent step size." Foreground="#98AABC" TextWrapping="Wrap" />
                    <TextBlock Text="Shift precision" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ShiftStepLabel}" Foreground="#A3E6D9" TextWrapping="Wrap" />
                    <Slider x:Name="ShiftStepSlider" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ShiftStepPercent}" AutomationProperties.Name="Shift precision increment" Margin="0,8,0,8" />
                    <TextBlock Text="Hold Shift to use this larger step size." Foreground="#98AABC" TextWrapping="Wrap" />
                    <CheckBox x:Name="ShowShiftMarkersToggle" Style="{StaticResource Switch}" IsChecked="{Binding ShowShiftMarkers}" Content="Show Shift increment dots" Margin="0,16,0,0" />
                    <TextBlock Text="Hide delay" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IdleLabel}" Foreground="#A3E6D9" TextWrapping="Wrap" />
                    <Slider x:Name="HideDelaySlider" Minimum="500" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding IdleMilliseconds}" AutomationProperties.Name="Wheel hide delay" Margin="0,8,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Application exclusions" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="App blacklist" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Pause controls while a listed application is focused. Uses exact executable names." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,10,0,16" />
                    <CheckBox x:Name="BlacklistEnabledToggle" Style="{StaticResource Switch}" IsChecked="{Binding ApplicationBlacklistEnabled}" Content="Enable app blacklist" />
                    <TextBlock Text="{Binding BlacklistStatus}" Foreground="#A3E6D9" TextWrapping="Wrap" Margin="0,12,0,14" />
                    <TextBlock Text="EXECUTABLE NAME · e.g. game.exe" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox x:Name="BlacklistAppBox" Text="{Binding NewBlacklistedApplication,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Blacklisted executable name" />
                    <WrapPanel Margin="0,12,0,8">
                      <Button Content="Add app" Click="AddBlacklistedApp" />
                      <Button Content="Browse app" Click="BrowseBlacklistedApp" />
                      <Button Content="Remove selected" Click="RemoveBlacklistedApp" />
                    </WrapPanel>
                    <ListBox x:Name="BlacklistAppList" ItemsSource="{Binding BlacklistedApplications}" SelectedItem="{Binding SelectedBlacklistedApplication}" Height="110" Background="#111B25" Foreground="#E9F0F5" BorderBrush="#293A49" Padding="8" AutomationProperties.Name="Blacklisted applications" />
                  </StackPanel>
                </Expander>
                <Button Content="Restore defaults" Tag="Settings" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,20,0,0" />
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="EffectsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Effects" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Adjust glow, particles, motion, and colors." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,7,0,20" />
                <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                  <StackPanel>
                    <CheckBox x:Name="PerformanceModeToggle" Style="{StaticResource Switch}" Content="Performance mode" IsChecked="{Binding Effects.PerformanceMode}" />
                    <TextBlock Text="Disables all animations. Your animation choices are restored when turned off." Foreground="#98AABC" FontSize="12" TextWrapping="Wrap" Margin="58,8,0,0" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.05*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Expander Header="Animations" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel x:Name="AnimationOptionsPanel" IsEnabled="{Binding AnimationControlsEnabled}" Margin="16,4,16,16">
                        <CheckBox Style="{StaticResource Switch}" Content="Opening and closing" IsChecked="{Binding AnimateOverlay}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Page and button transitions" IsChecked="{Binding AnimateInterface}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Hover feedback" IsChecked="{Binding AnimateHover}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Smooth volume bar" IsChecked="{Binding AnimateArc}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Sliding numbers" IsChecked="{Binding AnimateNumbers}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Volume bob" IsChecked="{Binding AnimateVolumeBob}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Shift spring" IsChecked="{Binding AnimateShift}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Mute shake and slash" IsChecked="{Binding AnimateMute}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Unmute recovery" IsChecked="{Binding AnimateUnmute}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Volume-limit recoil" IsChecked="{Binding AnimateLimit}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Click feedback" IsChecked="{Binding AnimateClick}" Margin="0,0,0,14" />
                        <CheckBox Style="{StaticResource Switch}" Content="Maximum glow and sparks" IsChecked="{Binding AnimateMaximum}" Margin="0,0,0,14" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Glow" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Bloom intensity" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.BloomPercent}" AutomationProperties.Name="Bloom intensity" />
                        <TextBlock Text="{Binding Effects.BloomPercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Particles" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Spark density" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.SparkCount}" AutomationProperties.Name="Spark density" />
                        <TextBlock Text="{Binding Effects.SparkCount,StringFormat={}{0} sparks}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Spark speed" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="25" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Effects.SparkSpeedPercent}" AutomationProperties.Name="Spark speed" />
                        <TextBlock Text="{Binding Effects.SparkSpeedPercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Mute feedback" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Mute shake strength" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.ShakePercent}" AutomationProperties.Name="Mute shake strength" />
                        <TextBlock Text="{Binding Effects.ShakePercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Mute animation speed" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Effects.MuteSpeedPercent}" AutomationProperties.Name="Mute animation speed" />
                        <TextBlock Text="{Binding Effects.MuteSpeedPercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Colors" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Wheel surface" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content=" " ToolTip="Choose color" AutomationProperties.Name="Choose wheel surface color" Tag="NormalColor" Click="PickColor" Width="34" Padding="0" Margin="6,0,0,0" Background="{Binding Effects.NormalColor}" BorderBrush="#587A89" BorderThickness="1" />
                          <TextBox Text="{Binding Effects.NormalColor,Mode=OneWay}" MaxLength="7" AutomationProperties.Name="Wheel surface color" x:Name="NormalColorBox" />
                        </DockPanel>
                        <Button Content="Apply color" Tag="NormalColor" Click="ApplyEffectColor" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="Muted wheel and label" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content=" " ToolTip="Choose color" AutomationProperties.Name="Choose muted wheel and label color" Tag="MutedColor" Click="PickColor" Width="34" Padding="0" Margin="6,0,0,0" Background="{Binding Effects.MutedColor}" BorderBrush="#587A89" BorderThickness="1" />
                          <TextBox Text="{Binding Effects.MutedColor,Mode=OneWay}" MaxLength="7" AutomationProperties.Name="Muted wheel and label color" x:Name="MutedColorBox" />
                        </DockPanel>
                        <Button Content="Apply color" Tag="MutedColor" Click="ApplyEffectColor" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="Muted speaker button" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <DockPanel>
                          <Button DockPanel.Dock="Right" Content=" " ToolTip="Choose color" AutomationProperties.Name="Choose muted speaker button color" Tag="MutedButtonColor" Click="PickColor" Width="34" Padding="0" Margin="6,0,0,0" Background="{Binding Effects.MutedButtonColor}" BorderBrush="#587A89" BorderThickness="1" />
                          <TextBox Text="{Binding Effects.MutedButtonColor,Mode=OneWay}" MaxLength="7" AutomationProperties.Name="Muted speaker button color" x:Name="MutedButtonColorBox" />
                        </DockPanel>
                        <Button Content="Apply color" Tag="MutedButtonColor" Click="ApplyEffectColor" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding EffectColorStatus}" Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,12" />
                        <TextBlock Text="Color changes take effect only after Apply color." Foreground="#98AABC" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Button Content="Restore defaults" Tag="Effects" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                    <TextBlock Text="Resets effect settings and colors." Foreground="#8095A5" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
                <Border Background="#111B25" CornerRadius="14" Padding="12" Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                  <StackPanel>
                    <Viewbox MaxWidth="350" HorizontalAlignment="Center">
                      <Canvas Width="396" Height="216">
                        <local:WheelControl x:Name="EffectsDemo" Canvas.Left="48" Canvas.Top="48" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}" />
                      </Canvas>
                    </Viewbox>
                    <WrapPanel HorizontalAlignment="Center">
                      <Button Content="Play max effect" Click="PreviewMaxEffect" />
                      <Button Content="Toggle preview mute" Click="PreviewMuteEffect" />
                    </WrapPanel>
                    <TextBlock Text="Preview only. Does not affect audio." Foreground="#98AABC" TextAlignment="Center" Margin="0,10,0,8" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
            <ScrollViewer x:Name="ProfilesPage" IsEnabled="{Binding Connected}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Profiles" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Save layouts and assign them to applications." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,7,0,20" />
                <Border CornerRadius="14" Background="#151E29" Padding="18">
                  <StackPanel>
                    <TextBlock Text="Active profile" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile,Mode=TwoWay}" AutomationProperties.Name="Active profile">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ActiveProfile.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Profile name" />
                    <Button Content="Manage profile  ▾" Click="OpenActions" HorizontalAlignment="Left" Margin="0,16,0,0">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="＋ New profile" Click="NewProfile" />
                          <MenuItem Header="Duplicate layout" Click="DuplicateProfile" />
                          <MenuItem Header="Remove profile" Click="RemoveProfile" />
                          <MenuItem Header="Export profile" Click="ExportProfile" />
                          <MenuItem Header="Export all" Click="ExportAllProfiles" />
                          <MenuItem Header="Import profiles" Click="ImportProfiles" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="Saves wheel appearance, order, and bindings. Switching profiles preserves audio levels." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
                <Expander Header="Automatic profile switching" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutomaticProfilesEnabled}" Content="Switch profiles with the focused app" />
                    <TextBlock Text="{Binding AutomaticProfileStatus}" Foreground="#A3E6D9" TextWrapping="Wrap" Margin="0,15,0,8" />
                    <TextBlock Text="App executables for this profile" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox x:Name="ProfileApplicationsBox" Text="{Binding ActiveProfile.Applications,UpdateSourceTrigger=PropertyChanged}" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2048" AutomationProperties.Name="Apps that activate this profile" />
                    <Button Content="Browse for app…" Click="AddProfileApp" HorizontalAlignment="Left" Margin="0,12,0,14" />
                    <TextBlock Text="Enter executable names separated by commas. The first match applies. Unmatched apps restore the manual profile." Foreground="#98AABC" TextWrapping="Wrap" />
                    <TextBlock Text="Exports include layout settings and app rules, excluding live audio levels. Imports add profiles without overwriting existing layouts." Foreground="#8095A5" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
                  </StackPanel>
                </Expander>
                <Button Content="Restore defaults" Tag="Profiles" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                <TextBlock Text="Disables automatic switching and clears this profile’s app rules. Preserves layouts." Foreground="#8095A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PlacementPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Placement" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Set the display, screen edge, and wheel spacing." Foreground="#98AABC" Margin="0,7,0,20" TextWrapping="Wrap" />
                <Expander Header="Screen and edge" IsExpanded="True" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Screen edge" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Edges}" SelectedItem="{Binding ScreenEdge,Mode=TwoWay}" AutomationProperties.Name="Screen edge" />
                    <TextBlock Text="Display" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox x:Name="MonitorBox" ItemsSource="{Binding Monitors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MonitorId,Mode=OneWay}" SelectionChanged="MonitorSelected" DropDownClosed="MonitorClosed" AutomationProperties.Name="Display" />
                  </StackPanel>
                </Expander>
                <Expander Header="Position and spacing" IsExpanded="True" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Position along edge" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding PositionPercent}" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Position along edge" />
                    <TextBlock Text="Start  ←  Center  →  End" Foreground="#98AABC" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="Distance from screen edge" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Slider x:Name="EdgeDistanceSlider" Minimum="0" Maximum="200" Value="{Binding EdgeDistance}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Distance from screen edge" />
                    <TextBlock Text="{Binding EdgeDistance,StringFormat={}{0} px}" Foreground="#98AABC" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <TextBlock Text="Space between wheels" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Slider Minimum="0" Maximum="36" Value="{Binding WheelSpacing}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Wheel spacing" />
                    <TextBlock Text="{Binding WheelSpacing,StringFormat={}{0} px}" Foreground="#98AABC" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <Button Content="Preview placement" Click="Preview" HorizontalAlignment="Left" />
                    <TextBlock Text="Edge scrolling opens the controls. Scroll over a wheel to adjust volume." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,18,0,0" />
                  </StackPanel>
                </Expander>
                <Button Content="Restore defaults" Tag="Placement" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                <TextBlock Text="Resets display, edge, position, distance, and spacing." Foreground="#8095A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Updates" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Keep WaveWheels up to date." Foreground="#98AABC" Margin="0,7,0,24" />
                <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12" Padding="24">
                  <StackPanel>
                    <TextBlock Text="Installed version" Foreground="#98AABC" FontSize="12" />
                    <TextBlock Text="{Binding AppVersionLabel}" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,18" />
                    <TextBlock Text="{Binding UpdateStatus}" Foreground="#BBCAD4" TextWrapping="Wrap" FontSize="14" />
                    <TextBlock x:Name="BetaVersionWarning" Text="{Binding LatestBetaWarning}" Foreground="#F4B16F" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowBetaVersionWarning}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar x:Name="UpdateDownloadProgress" Value="{Binding UpdateProgress,Mode=OneWay}" Maximum="100" Height="5" Margin="0,20,0,0">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallingUpdate}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                    <WrapPanel Margin="0,20,0,0">
                      <Button x:Name="InstallUpdateButton" Content="Download and install" Click="InstallUpdate" IsEnabled="{Binding CanInstallUpdate}" Background="#73DCC8" Foreground="#10231F">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanInstallUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates" IsEnabled="{Binding CanCheckUpdates}" />
                      <Button x:Name="StableSwitchButton" Content="{Binding StableSwitchLabel}" Click="InstallStable" IsEnabled="{Binding CanInstallStable}" Background="#73DCC8" Foreground="#10231F">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowStableSwitch}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                      </Button>
                      <Button x:Name="CancelUpdateButton" Content="Cancel download" Click="CancelUpdate" IsEnabled="{Binding InstallingUpdate}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding InstallingUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button Content="View release notes" Click="ViewReleaseNotes" Background="Transparent" Foreground="#98AABC" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Expander x:Name="ReleaseNotesPanel" Header="{Binding ReleaseNotesTitle}" IsExpanded="False" Margin="0,16,0,0">
                  <StackPanel Margin="20,0,20,20">
                    <TextBox x:Name="ReleaseNotesContent" Text="{Binding ReleaseNotesText,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="300" MinHeight="100" Background="Transparent" BorderThickness="0" Padding="0,8" FontSize="13" AutomationProperties.Name="Release notes" />
                    <Button Content="Open release on GitHub ↗" Click="OpenRelease" Background="Transparent" Foreground="#98AABC" HorizontalAlignment="Left" Margin="0,10,0,0" />
                  </StackPanel>
                </Expander>
                <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,16,0,16">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                      </Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Release channel" FontWeight="SemiBold" />
                        <TextBlock Text="Stable for regular use. Beta for preview builds." Foreground="#98AABC" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                      </StackPanel>
                      <ComboBox Grid.Column="1" x:Name="UpdateChannelPicker" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" IsEnabled="{Binding CanCheckUpdates}" VerticalAlignment="Center" AutomationProperties.Name="Release channel" />
                    </Grid>
                    <Border BorderBrush="#293A49" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0">
                      <StackPanel>
                        <DockPanel>
                          <Button Content="Repair app" Click="RepairApp" IsEnabled="{Binding CanCheckUpdates}" DockPanel.Dock="Right" Margin="12,0,0,0" ToolTip="Reinstall the latest stable release and keep your settings" />
                          <CheckBox Content="Notify me about updates" Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdatesAutomatically}" VerticalAlignment="Center" />
                        </DockPanel>
                        <CheckBox Content="Automatic updates" Style="{StaticResource Switch}" IsChecked="{Binding AutoInstallUpdates}" Margin="0,18,0,0" />
                        <TextBlock Text="Check and install newer releases from your selected channel at Windows sign-in." Foreground="#98AABC" FontSize="12" TextWrapping="Wrap" Margin="58,8,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>
                <Expander x:Name="VersionHistory" Header="Version history" Margin="0,0,0,12">
                  <StackPanel Margin="20,0,20,20">
                    <TextBlock Text="Latest stable" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StableReleaseLabel}" Foreground="#98AABC" Margin="0,7,0,12" TextWrapping="Wrap" />
                    <Button x:Name="InstallStableButton" Content="Switch to stable" Click="InstallStable" IsEnabled="{Binding CanInstallStable}" HorizontalAlignment="Left" />
                    <TextBlock Text="You can return to Stable even if its version is older." Foreground="#98AABC" FontSize="12" Margin="0,8,0,24" TextWrapping="Wrap" />
                    <TextBlock Text="Beta archive" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Choose Beta above to install a previous preview." Foreground="#98AABC" Margin="0,7,0,12" TextWrapping="Wrap" FontSize="12" />
                    <ListBox x:Name="BetaBuildList" ItemsSource="{Binding BetaBuilds}" SelectedItem="{Binding SelectedBetaBuild}" Height="166" Background="#0D151E" Foreground="#E9F0F5" BorderBrush="#293A49" IsEnabled="{Binding BetaChannelEnabled}" AutomationProperties.Name="Previous beta versions">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DisplayVersion}" />
                            <TextBlock Grid.Column="1" Text="Beta" Foreground="#8596A6" FontSize="11" Margin="20,0,0,0" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,14,0,0">
                      <Button Content="View notes" Click="ViewBetaNotes" IsEnabled="{Binding BetaChannelEnabled}" />
                      <Button x:Name="InstallBetaButton" Content="Install selected beta" Click="InstallBeta" IsEnabled="{Binding CanInstallBeta}" />
                      <Button Content="Release details ↗" Click="OpenBetaRelease" Background="Transparent" Foreground="#98AABC" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
                <TextBlock Text="Updates restart the app. Your settings and layouts are preserved." Foreground="#8596A6" FontSize="12" Margin="0,10,0,8" TextWrapping="Wrap" />
                <Button Content="Restore defaults" Click="RestoreDefaults" Tag="Updates" HorizontalAlignment="Left" Background="Transparent" Foreground="#98AABC" Margin="0,10,0,0" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="StartupPage" Visibility="Collapsed">
              <TextBlock Text="Startup" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="Control automatic launch at Windows sign-in." Foreground="#98AABC" Margin="0,10,0,30" TextWrapping="Wrap" />
              <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                  <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupEnabled}" Content="Start at Windows sign-in" AutomationProperties.Name="Start with Windows" />
                  <TextBlock Text="{Binding StartupDescription}" Foreground="#98AABC" TextWrapping="Wrap" Margin="58,12,0,0" />
                </StackPanel>
              </Border>
              <TextBlock Text="The app starts in the system tray. Click its icon to open configuration." Foreground="#8095A5" TextWrapping="Wrap" Margin="0,26,0,0" />
              <Button Content="Restore defaults" Tag="Startup" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
              <TextBlock Text="Disables launch at sign-in." Foreground="#8095A5" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer x:Name="ConnectionPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Connection" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Manage the local Wave Link connection." Foreground="#98AABC" Margin="0,10,0,30" TextWrapping="Wrap" />
                <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                  <StackPanel>
                    <CheckBox Content="Use Windows Audio" IsChecked="{Binding UseWindowsAudio}" Style="{StaticResource Switch}" />
                    <TextBlock Text="Use the Windows wheel manually. Turn off to use Wave Link when available." Foreground="#98AABC" TextWrapping="Wrap" FontSize="12" Margin="58,8,0,0" />
                  </StackPanel>
                </Border>
                <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="14" Padding="18">
                  <StackPanel>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ChannelCount}" Foreground="#98AABC" Margin="0,10,0,22" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WindowsAudioStatus}" Foreground="#F4B16F" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <WrapPanel>
                      <Button x:Name="StartWaveLinkButton" Content="Find and start Wave Link" Click="FindAndStartWaveLink" />
                      <Button Content="Locate Wave Link…" Click="LocateWaveLink" />
                    </WrapPanel>
                    <TextBlock Text="Finds desktop and Store installations. Select WaveLink.exe manually if needed." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button Content="Reconnect Wave Link" HorizontalAlignment="Left" Click="Reconnect" Background="#73DCC8" Foreground="#10231F" />
                  </StackPanel>
                </Border>
                <Expander Header="Advanced connection settings" IsExpanded="False" Margin="0,12,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Local port override" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding PortText,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Local port override" />
                    <TextBlock Text="Leave blank for automatic discovery." Foreground="#8095A5" FontSize="12" Margin="0,10,0,20" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="Windows Audio is used while disconnected. Your saved channel wheels return on connection. Volume and mute stay independent." Foreground="#8095A5" TextWrapping="Wrap" Margin="0,26,0,0" />
                <Button Content="Restore defaults" Tag="Connection" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                <TextBlock Text="Restores automatic port discovery and reconnects." Foreground="#8095A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="SetupPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Set up WaveWheels" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="SetupStepLabel" Text="1 of 3 · Audio" Foreground="#73DCC8" FontSize="12" Margin="0,8,0,24" />
              </StackPanel>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                  <StackPanel x:Name="SetupAudioStep">
                    <TextBlock Text="Your audio, connected automatically" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding AudioModeDescription}" Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,20" />
                    <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12" Padding="20">
                      <StackPanel>
                        <TextBlock Text="{Binding ConnectionLabel}" Foreground="{Binding ModeAccent}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ChannelCount}" Foreground="#98AABC" Margin="0,10,0,18" TextWrapping="Wrap" />
                        <WrapPanel>
                          <Button Content="Find Wave Link" Click="FindAndStartWaveLink" />
                          <Button Content="Connection settings" Tag="Connection" Click="Navigate" Background="Transparent" Foreground="#98AABC" />
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Wave Link is optional. You can continue with Windows Audio and connect it later." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,20,0,0" />
                  </StackPanel>
                  <StackPanel x:Name="SetupPlacementStep" Visibility="Collapsed">
                    <TextBlock Text="Choose where wheels appear" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Scroll at this edge to reveal your wheels." Foreground="#98AABC" Margin="0,12,0,20" />
                    <Border Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12" Padding="20">
                      <StackPanel>
                        <TextBlock Text="Screen edge" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Edges}" SelectedItem="{Binding ScreenEdge}" AutomationProperties.Name="Setup screen edge" />
                        <TextBlock Text="Display" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SetupMonitorBox" ItemsSource="{Binding Monitors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MonitorId,Mode=OneWay}" DropDownClosed="SetupMonitorClosed" AutomationProperties.Name="Setup display" />
                        <TextBlock Text="Wheel size" Style="{StaticResource FieldLabel}" />
                        <TextBlock Text="{Binding WheelSizeLabel}" Foreground="#A3E6D9" />
                        <Slider Minimum="50" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WheelSizePercent}" AutomationProperties.Name="Setup wheel size" Margin="0,10,0,0" />
                      </StackPanel>
                    </Border>
                    <TextBlock Text="Position, spacing, and edge distance are available in Appearance → Placement." Foreground="#98AABC" FontSize="12" TextWrapping="Wrap" Margin="0,18,0,0" />
                  </StackPanel>
                  <StackPanel x:Name="SetupTryStep" Visibility="Collapsed">
                    <TextBlock Text="Try the controls" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Scroll the sample wheel and try mute. Your audio is unaffected." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Viewbox Height="210" Stretch="Uniform" HorizontalAlignment="Left">
                      <Canvas Width="396" Height="216">
                        <local:WheelControl x:Name="SetupDemo" Canvas.Left="48" Canvas.Top="48" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}" />
                      </Canvas>
                    </Viewbox>
                    <TextBlock Text="At the screen edge: scroll to open, pause briefly, then move over a wheel and scroll to adjust." Foreground="#BBCAD4" TextWrapping="Wrap" Margin="0,0,0,20" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupEnabled}" Content="Start at Windows sign-in" AutomationProperties.Name="Setup start with Windows" />
                    <TextBlock Text="Closing configuration keeps the wheels running. Reopen it from the system tray." Foreground="#98AABC" TextWrapping="Wrap" FontSize="12" Margin="0,18,0,10" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>
              <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Skip guide" Click="FinishSetup" HorizontalAlignment="Left" Background="Transparent" Foreground="#98AABC" />
                <Button x:Name="SetupBackButton" Grid.Column="1" Content="Back" Click="SetupBack" Visibility="Collapsed" />
                <Button x:Name="SetupNextButton" Grid.Column="2" Content="Continue" Click="SetupNext" Background="#73DCC8" Foreground="#10231F" Margin="0" MinWidth="110" />
              </Grid>
            </Grid>
          </Grid>
        </DockPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#24323F" BorderThickness="0,1,0,0" Background="#0D141C">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Message}" Foreground="#98AABC" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="{Binding Message}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Foreground="#8596A6" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
