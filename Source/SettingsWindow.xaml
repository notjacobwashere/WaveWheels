<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:WaveWheels" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WaveWheels.SettingsWindow" Icon="/WaveWheels;component/Assets/WaveWheels.ico" Title="WaveWheels 0.10.3-beta.1 · Configuration" Width="1160" Height="860" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" WindowStyle="None" Background="#0D141C" Foreground="#E9F0F5" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="14" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <Border local:InterfaceMotion.Enabled="{Binding AnimateWheels}" BorderBrush="#293A49" BorderThickness="1" CornerRadius="14" Background="#101820">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="66" />
        <RowDefinition Height="*" />
        <RowDefinition Height="38" />
      </Grid.RowDefinitions>
      <Border x:Name="TitleBar" Background="Transparent" BorderBrush="#24323F" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleDrag">
        <Grid Margin="22,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="43" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="86" />
          </Grid.ColumnDefinitions>
          <Image x:Name="HeaderAppIcon" Source="/WaveWheels;component/Assets/WaveWheels.ico" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock Text="WaveWheels" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="/  DESKTOP AUDIO" Foreground="#847A94" FontSize="10" VerticalAlignment="Center" Margin="12,3,0,0" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Column="2" CornerRadius="14" BorderBrush="#383344" BorderThickness="1" Padding="11,5" VerticalAlignment="Center" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="5" Height="5" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#C7A16C" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Connected}" Value="True">
                        <Setter Property="Fill" Value="#8ED7BB" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock Text="{Binding ConnectionLabel}" Foreground="#B6B0C2" FontSize="9" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="−" Width="34" Padding="0,5" Background="Transparent" Click="Minimize" AutomationProperties.Name="Minimize" />
            <Button Content="×" Width="34" Padding="0,5" Background="Transparent" Click="HideConfig" ToolTip="Close configuration; wheels keep running" AutomationProperties.Name="Close configuration" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="176" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#0C1219" BorderBrush="#24323F" BorderThickness="0,0,1,0">
          <DockPanel Margin="14,25,14,18">
            <StackPanel DockPanel.Dock="Bottom">
              <TextBlock Text="Scroll at the screen edge&#10;to open the controls." Foreground="#9E95AB" FontSize="12" LineHeight="20" Margin="6,0,0,19" TextWrapping="Wrap" />
              <Button x:Name="PreviewToggleButton" Content="{Binding PreviewButtonLabel}" Click="Preview" Margin="0" FontWeight="SemiBold">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="#73DCC8" />
                    <Setter Property="Foreground" Value="#10231F" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPreviewing}" Value="True">
                        <Setter Property="Background" Value="#49335F" />
                        <Setter Property="Foreground" Value="#E5D5FF" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <TextBlock Text="{Binding AppVersion}" TextWrapping="Wrap" Foreground="#514B5E" FontSize="9" Margin="6,17,0,0" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <TextBlock Text="WORKSPACE" Foreground="#8095A5" FontSize="9" Margin="12,0,0,12" />
                <Button x:Name="WheelsNav" Style="{StaticResource NavButton}" Content="◉   Wheels" Tag="Wheels" Background="#1C3637" Foreground="#DFC9FF" Click="Navigate" />
                <Button x:Name="ProfilesNav" IsEnabled="{Binding Connected}" Style="{StaticResource NavButton}" Content="▤   Profiles" Tag="Profiles" Click="Navigate" />
                <Expander Header="Customize" IsExpanded="True" Background="#0C1219" BorderThickness="0" Margin="0,2,0,4">
                  <StackPanel Margin="5,0,0,4">
                    <Button x:Name="EffectsNav" Style="{StaticResource NavButton}" Content="✦   Effects" Tag="Effects" Click="Navigate" />
                    <Button x:Name="PlacementNav" Style="{StaticResource NavButton}" Content="⌖   Placement" Tag="Placement" Click="Navigate" />
                  </StackPanel>
                </Expander>
                <Expander Header="Preferences" IsExpanded="False" Background="#0C1219" BorderThickness="0" Margin="0,2,0,4">
                  <StackPanel Margin="5,0,0,4">
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="⚙   Settings" Tag="Settings" Click="Navigate" />
                    <Button x:Name="StartupNav" Style="{StaticResource NavButton}" Content="↗   Startup" Tag="Startup" Click="Navigate" />
                    <Button x:Name="ConnectionNav" Style="{StaticResource NavButton}" Content="⌁   Connection" Tag="Connection" Click="Navigate" />
                  </StackPanel>
                </Expander>
                <Button x:Name="UpdatesNav" Style="{StaticResource NavButton}" Content="↻   Updates" Tag="Updates" Click="Navigate" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="28,20,28,20">
          <Border x:Name="AudioModeBanner" DockPanel.Dock="Top" Background="#14232B" CornerRadius="8" Padding="14,10" Margin="0,0,0,20">
            <DockPanel>
              <Button Content="Connection" Tag="Connection" Click="Navigate" Padding="12,6" Margin="12,0,0,0" DockPanel.Dock="Right" />
              <StackPanel>
                <TextBlock Text="{Binding AudioModeTitle}" Foreground="{Binding ModeAccent}" FontWeight="SemiBold" FontSize="10" />
                <TextBlock Text="{Binding ChannelCount}" Foreground="#98AABC" FontSize="11" Margin="0,3,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid ClipToBounds="True">
            <Grid x:Name="WheelsPage">
              <Grid.RowDefinitions>
                <RowDefinition Height="98" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Wheels" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="Configure wheel appearance, order, and audio controls." Foreground="#98AABC" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="WHEELS" FontSize="9" Foreground="#8C829D" VerticalAlignment="Center" Margin="0,0,10,0" TextWrapping="Wrap" />
                  <ComboBox x:Name="CountBox" Width="66" SelectedItem="{Binding DisplayWheelCount, Mode=TwoWay}" IsEnabled="{Binding Connected}" AutomationProperties.Name="Number of wheels" />
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="1.12*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="STACK ORDER" Foreground="#9E91AE" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="  /  TOP → BOTTOM" Foreground="#5E556B" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Grid Grid.Column="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="SIZE" Foreground="#8E819D" FontSize="9" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Slider Grid.Column="1" Minimum="50" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WheelSizePercent}" Margin="13,0" VerticalAlignment="Center" AutomationProperties.Name="Wheel size" />
                  <TextBlock Grid.Column="2" Text="{Binding WheelSizeLabel}" Foreground="#A3E6D9" FontSize="11" VerticalAlignment="Center" Width="39" TextAlignment="Right" TextWrapping="Wrap" />
                </Grid>
              </Grid>
              <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="1.12*" />
                </Grid.ColumnDefinitions>
                <DockPanel>
                  <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                    <Button Content="＋  Add a wheel" IsEnabled="{Binding Connected}" Click="Add" Background="#1C2D39" Foreground="#D9BFEF" BorderBrush="#4E3D60" Margin="0" />
                    <TextBlock Text="{Binding WheelArrangementHint}" TextWrapping="Wrap" Foreground="#8095A5" FontSize="10" Margin="0,11,0,0" />
                  </StackPanel>
                  <AdornerDecorator>
                    <ListBox x:Name="WheelList" ItemsSource="{Binding DisplayWheels}" SelectedItem="{Binding EditorWheel}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False" VirtualizingPanel.IsVirtualizing="False" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" PreviewKeyDown="ReorderKey" DragOver="DragOverWheel" DragLeave="DragLeaveWheel" Drop="DropWheel" AutomationProperties.Name="Wheel arrangement">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel />
                        </ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                      <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                          <Setter Property="Foreground" Value="#E5DEF0" />
                          <Setter Property="Margin" Value="0,0,0,10" />
                          <Setter Property="Padding" Value="0" />
                          <Setter Property="Template">
                            <Setter.Value>
                              <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Background="#151E29" BorderBrush="#293A49" BorderThickness="1" CornerRadius="12">
                                  <Grid>
                                    <Border x:Name="SelectionStrip" Width="3" Background="{Binding Accent}" HorizontalAlignment="Left" CornerRadius="2" Margin="0,15" Opacity="0" />
                                    <ContentPresenter Margin="4,4,8,4" />
                                  </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                  <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="#1B3136" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#468C83" />
                                    <Setter TargetName="SelectionStrip" Property="Opacity" Value="1" />
                                  </Trigger>
                                  <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="#6B586E" />
                                  </Trigger>
                                </ControlTemplate.Triggers>
                              </ControlTemplate>
                            </Setter.Value>
                          </Setter>
                        </Style>
                      </ListBox.ItemContainerStyle>
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid MinHeight="88">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="36" />
                              <ColumnDefinition Width="66" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Border Background="Transparent" Tag="DragHandle" IsEnabled="{Binding DataContext.Connected,RelativeSource={RelativeSource AncestorType=ListBox}}" Cursor="SizeNS" ToolTip="Drag to reorder" AutomationProperties.Name="Drag wheel">
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding OrderLabel}" Foreground="#776A85" FontSize="9" HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" />
                                <TextBlock Text="⠿" Foreground="#A08BB1" FontSize="22" HorizontalAlignment="Center" TextWrapping="Wrap" />
                              </StackPanel>
                            </Border>
                            <Viewbox Grid.Column="1" Width="60" Height="60" IsHitTestVisible="False">
                              <local:WheelControl Compact="True" UseMuteButton="{Binding DataContext.UseMuteButton,RelativeSource={RelativeSource AncestorType=ListBox}}" Wheel="{Binding}" />
                            </Viewbox>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,6,0">
                              <TextBlock Text="{Binding Name}" Foreground="#E5DEF0" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Detail}" Foreground="#81768D" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding VolumeLabel}" Foreground="{Binding Accent}" FontSize="10" Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" IsEnabled="{Binding DataContext.Connected,RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center">
                              <Button Content="↑" Tag="{Binding}" Click="RowUp" Padding="0,3" Margin="0,0,0,3" Background="Transparent" Foreground="#B8A6C7" AutomationProperties.Name="Move this wheel up" />
                              <Button Content="↓" Tag="{Binding}" Click="RowDown" Padding="0,3" Margin="0" Background="Transparent" Foreground="#B8A6C7" AutomationProperties.Name="Move this wheel down" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </AdornerDecorator>
                </DockPanel>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <Border x:Name="WheelPreviewFrame" CornerRadius="14" BorderBrush="#293A49" BorderThickness="1" Background="#111B25" Padding="16">
                      <StackPanel>
                        <TextBlock Text="LIVE PREVIEW" Foreground="#98AABC" FontSize="10" TextWrapping="Wrap" />
                        <Grid x:Name="WheelPreviewStage" ClipToBounds="True" Height="{Binding PreviewHeight}" Margin="0,8,0,0">
                          <Viewbox x:Name="WheelPreviewViewport" MaxWidth="{Binding PreviewWidth}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="{Binding PreviewCanvasWidth}" Height="216">
                              <local:WheelControl x:Name="SelectedPreview" Canvas.Left="48" Canvas.Top="48" Wheel="{Binding EditorWheel}" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}" />
                            </Canvas>
                          </Viewbox>
                        </Grid>
                        <TextBlock Text="Scaled to fit the preview." Foreground="#8095A5" FontSize="10" Margin="0,8,0,0" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Expander Header="Appearance" IsExpanded="True" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <Grid Margin="0,17,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="WHEEL SETTINGS" Foreground="#9C8AA9" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                          <Button Grid.Column="1" Content="Remove wheel" IsEnabled="{Binding Connected}" Click="Remove" Background="Transparent" Foreground="#B48FA3" Padding="0,2" Margin="0" FontSize="10" />
                        </Grid>
                        <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding EditorWheel.Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" AutomationProperties.Name="Wheel name" />
                        <TextBlock Text="COLOR" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="104" />
                          </Grid.ColumnDefinitions>
                          <UniformGrid Rows="1" Columns="6" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Button Tag="#36BBD3" Background="#36BBD3" Height="24" Padding="0" Click="SetColor" AutomationProperties.Name="Cyan accent" />
                            <Button Tag="#DA5DAD" Background="#DA5DAD" Padding="0" Click="SetColor" AutomationProperties.Name="Pink accent" />
                            <Button Tag="#A99AFF" Background="#A99AFF" Padding="0" Click="SetColor" AutomationProperties.Name="Violet accent" />
                            <Button Tag="#63CEA4" Background="#63CEA4" Padding="0" Click="SetColor" AutomationProperties.Name="Mint accent" />
                            <Button Tag="#F4B16F" Background="#F4B16F" Padding="0" Click="SetColor" AutomationProperties.Name="Amber accent" />
                            <Button Tag="#F18D93" Background="#F18D93" Padding="0" Margin="0" Click="SetColor" AutomationProperties.Name="Coral accent" />
                          </UniformGrid>
                          <TextBox Grid.Column="1" x:Name="ColorBox" Text="{Binding EditorWheel.Color,Mode=OneWay}" MaxLength="7" LostFocus="ApplyHex" KeyDown="ColorKey" FontSize="11" Padding="8,10" AutomationProperties.Name="Custom hex color" />
                        </Grid>
                      </StackPanel>
                    </Expander>
                    <Expander Header="Audio controls" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <StackPanel x:Name="WaveLinkBindingFields">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Connected}" Value="True">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <TextBlock Text="INPUT CHANNEL" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                          <ComboBox x:Name="ChannelBox" IsEnabled="{Binding Connected}" ItemsSource="{Binding Channels}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorWheel.ChannelId,Mode=OneWay}" SelectionChanged="ChannelSelected" DropDownClosed="ChannelClosed" AutomationProperties.Name="Wave Link input channel" />
                          <TextBlock Text="MIX SCOPE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                          <ComboBox x:Name="MixBox" IsEnabled="{Binding Connected}" ItemsSource="{Binding MixChoices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding EditorWheel.MixId,Mode=OneWay}" SelectionChanged="MixSelected" DropDownClosed="MixClosed" AutomationProperties.Name="Mix scope" />
                        </StackPanel>
                        <TextBlock Text="MAXIMUM VOLUME" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding EditorWheel.MaximumVolumeLabel}" Foreground="#A3E6D9" FontSize="13" TextWrapping="Wrap" />
                        <Slider x:Name="VolumeLimitSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding EditorWheel.MaximumVolumePercent}" AutomationProperties.Name="Maximum wheel volume" Margin="0,8,0,4" />
                        <TextBlock Text="Applies to changes made in WaveWheels. Shared bindings use the lowest limit." Foreground="#8095A5" FontSize="10" TextWrapping="Wrap" />
                        <Button Content="Restore defaults" Tag="Wheels" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,18,0,8" />
                        <TextBlock Text="Resets this wheel’s name, color, and limit. Preserves its binding." Foreground="#8095A5" FontSize="10" TextWrapping="Wrap" />
                        <TextBlock Text="Click to mute. Enable a dedicated mute button in Settings." Foreground="#72667F" FontSize="10" TextWrapping="Wrap" Margin="0,12,0,12" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Grid>
            <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Controls" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="Configure wheel behavior and input." Foreground="#98AABC" Margin="0,8,0,24" />
                <Expander Header="Size and motion" IsExpanded="True" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <Grid>
                      <TextBlock Text="Wheel size" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding WheelSizeLabel}" HorizontalAlignment="Right" Foreground="#A3E6D9" FontSize="23" TextWrapping="Wrap" />
                    </Grid>
                    <Slider x:Name="WheelSizeSlider" Minimum="50" Maximum="180" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding WheelSizePercent}" Margin="0,22,0,10" AutomationProperties.Name="Overlay wheel size" />
                    <Grid>
                      <TextBlock Text="50%" Foreground="#776787" FontSize="10" TextWrapping="Wrap" />
                      <TextBlock Text="180%" Foreground="#776787" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap" />
                    </Grid>
                    <TextBlock Text="Scales the complete wheel. Large layouts fit the display automatically." Foreground="#98AABC" FontSize="12" TextWrapping="Wrap" Margin="0,20,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Animations" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AnimateWheels}" Content="Toggle animations" AutomationProperties.Name="Animate wheels" />
                    <TextBlock Text="Enable app and wheel animations. Respects Windows motion settings." Foreground="#98AABC" TextWrapping="Wrap" Margin="58,12,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Mute behavior" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <CheckBox x:Name="UseMuteButtonToggle" Style="{StaticResource Switch}" IsChecked="{Binding UseMuteButton}" Content="Show a dedicated mute button" AutomationProperties.Name="Use dedicated mute button" />
                    <TextBlock Text="When enabled, only the speaker button toggles mute; dragging adjusts volume. Otherwise, click the wheel to mute and scroll to adjust." Foreground="#98AABC" TextWrapping="Wrap" Margin="58,12,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Scroll and Shift steps" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Scroll controls" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ScrollStepLabel}" Foreground="#A3E6D9" Margin="0,14,0,6" TextWrapping="Wrap" />
                    <Slider x:Name="ScrollStepSlider" Minimum="1" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ScrollStepPercent}" AutomationProperties.Name="Volume step per scroll notch" />
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ScrollAccelerationEnabled}" Content="Accelerate fast scrolling" Margin="0,20,0,14" />
                    <TextBlock Text="Disable acceleration for a consistent step size." Foreground="#98AABC" TextWrapping="Wrap" />
                    <TextBlock Text="SHIFT PRECISION" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ShiftStepLabel}" Foreground="#A3E6D9" TextWrapping="Wrap" />
                    <Slider x:Name="ShiftStepSlider" Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding ShiftStepPercent}" AutomationProperties.Name="Shift precision increment" Margin="0,8,0,8" />
                    <TextBlock Text="Hold Shift to use this larger step size." Foreground="#98AABC" TextWrapping="Wrap" />
                    <CheckBox x:Name="ShowShiftMarkersToggle" Style="{StaticResource Switch}" IsChecked="{Binding ShowShiftMarkers}" Content="Show Shift increment dots" Margin="0,16,0,0" />
                    <TextBlock Text="HIDE DELAY" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding IdleLabel}" Foreground="#A3E6D9" TextWrapping="Wrap" />
                    <Slider x:Name="HideDelaySlider" Minimum="500" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True" Value="{Binding IdleMilliseconds}" AutomationProperties.Name="Wheel hide delay" Margin="0,8,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Interaction guide" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="Using the controls" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Scroll at the screen edge to open the wheels. Pause, then scroll over a wheel to adjust volume. Click to toggle mute." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Application exclusions" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="App blacklist" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Pause controls while a listed application is focused. Uses exact executable names." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,10,0,16" />
                    <CheckBox x:Name="BlacklistEnabledToggle" Style="{StaticResource Switch}" IsChecked="{Binding ApplicationBlacklistEnabled}" Content="Enable app blacklist" />
                    <TextBlock Text="{Binding BlacklistStatus}" Foreground="#A3E6D9" TextWrapping="Wrap" Margin="0,12,0,14" />
                    <TextBlock Text="EXECUTABLE NAME · e.g. game.exe" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox x:Name="BlacklistAppBox" Text="{Binding NewBlacklistedApplication,UpdateSourceTrigger=PropertyChanged}" MaxLength="160" AutomationProperties.Name="Blacklisted executable name" />
                    <WrapPanel Margin="0,12,0,8">
                      <Button Content="Add app" Click="AddBlacklistedApp" />
                      <Button Content="Browse app" Click="BrowseBlacklistedApp" />
                      <Button Content="Remove selected" Click="RemoveBlacklistedApp" />
                    </WrapPanel>
                    <ListBox x:Name="BlacklistAppList" ItemsSource="{Binding BlacklistedApplications}" SelectedItem="{Binding SelectedBlacklistedApplication}" Height="110" Background="#111B25" Foreground="#E9F0F5" BorderBrush="#393040" Padding="8" AutomationProperties.Name="Blacklisted applications" />
                  </StackPanel>
                </Expander>
                <Button Content="Restore defaults" Tag="Settings" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,20,0,0" />
              </StackPanel>
            </ScrollViewer>
            <Grid x:Name="EffectsPage" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Effects" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Adjust glow, particles, motion, and colors." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,24" />
              </StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1.05*" />
                  <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <Expander Header="Glow" IsExpanded="True" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Bloom intensity" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.BloomPercent}" AutomationProperties.Name="Bloom intensity" />
                        <TextBlock Text="{Binding Effects.BloomPercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Particles" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Spark density" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.SparkCount}" AutomationProperties.Name="Spark density" />
                        <TextBlock Text="{Binding Effects.SparkCount,StringFormat={}{0} sparks}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Spark speed" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="25" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Effects.SparkSpeedPercent}" AutomationProperties.Name="Spark speed" />
                        <TextBlock Text="{Binding Effects.SparkSpeedPercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Mute feedback" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Mute shake strength" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="0" Maximum="200" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding Effects.ShakePercent}" AutomationProperties.Name="Mute shake strength" />
                        <TextBlock Text="{Binding Effects.ShakePercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                        <TextBlock Text="Mute animation speed" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <Slider Minimum="50" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Effects.MuteSpeedPercent}" AutomationProperties.Name="Mute animation speed" />
                        <TextBlock Text="{Binding Effects.MuteSpeedPercent,StringFormat={}{0}%}" Foreground="#A3E6D9" Margin="0,8,0,10" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Expander Header="Colors" IsExpanded="False" Margin="0,0,0,12">
                      <StackPanel Margin="16,4,16,16">
                        <TextBlock Text="Wheel surface" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Effects.NormalColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Wheel surface color" />
                        <TextBlock Text="Muted wheel and label" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Effects.MutedColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Muted wheel and label color" />
                        <TextBlock Text="Muted speaker button" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <TextBox Text="{Binding Effects.MutedButtonColor,UpdateSourceTrigger=PropertyChanged}" MaxLength="7" AutomationProperties.Name="Muted speaker button color" />
                        <TextBlock Text="{Binding EffectColorStatus}" Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,12" />
                        <TextBlock Text="Requires animations enabled in Settings. Respects Windows motion settings." Foreground="#98AABC" TextWrapping="Wrap" />
                      </StackPanel>
                    </Expander>
                    <Button Content="Restore defaults" Tag="Effects" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                    <TextBlock Text="Resets effect settings and colors." Foreground="#8095A5" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
                <Border Background="#111B25" CornerRadius="14" Padding="12" Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                  <StackPanel>
                    <Viewbox MaxWidth="350" HorizontalAlignment="Center">
                      <Canvas Width="396" Height="216">
                        <local:WheelControl x:Name="EffectsDemo" Canvas.Left="48" Canvas.Top="48" Effects="{Binding Effects}" EffectsEnabled="{Binding AnimateWheels}" UseMuteButton="{Binding UseMuteButton}" />
                      </Canvas>
                    </Viewbox>
                    <WrapPanel HorizontalAlignment="Center">
                      <Button Content="Play max effect" Click="PreviewMaxEffect" />
                      <Button Content="Toggle preview mute" Click="PreviewMuteEffect" />
                    </WrapPanel>
                    <TextBlock Text="Preview only. Does not affect audio." Foreground="#98AABC" TextAlignment="Center" Margin="0,10,0,8" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
            <ScrollViewer x:Name="ProfilesPage" IsEnabled="{Binding Connected}" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Profiles" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Save layouts and assign them to applications." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,12,0,28" />
                <Border CornerRadius="14" Background="#151E29" Padding="18">
                  <StackPanel>
                    <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox x:Name="ProfilePicker" ItemsSource="{Binding Profiles}" SelectedItem="{Binding ActiveProfile,Mode=TwoWay}" AutomationProperties.Name="Active profile">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="PROFILE NAME" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding ActiveProfile.Name,UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="Profile name" />
                    <Button Content="Manage profile  ▾" Click="OpenActions" HorizontalAlignment="Left" Margin="0,16,0,0">
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="＋ New profile" Click="NewProfile" />
                          <MenuItem Header="Duplicate layout" Click="DuplicateProfile" />
                          <MenuItem Header="Remove profile" Click="RemoveProfile" />
                          <MenuItem Header="Export profile" Click="ExportProfile" />
                          <MenuItem Header="Export all" Click="ExportAllProfiles" />
                          <MenuItem Header="Import profiles" Click="ImportProfiles" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="Saves wheel appearance, order, and bindings. Switching profiles preserves audio levels." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,20,0,0" />
                  </StackPanel>
                </Border>
                <Expander Header="Automatic profile switching" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutomaticProfilesEnabled}" Content="Switch profiles with the focused app" />
                    <TextBlock Text="{Binding AutomaticProfileStatus}" Foreground="#A3E6D9" TextWrapping="Wrap" Margin="0,15,0,8" />
                    <TextBlock Text="APP EXECUTABLES FOR THIS PROFILE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox x:Name="ProfileApplicationsBox" Text="{Binding ActiveProfile.Applications,UpdateSourceTrigger=PropertyChanged}" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="2048" AutomationProperties.Name="Apps that activate this profile" />
                    <Button Content="Browse for app…" Click="AddProfileApp" HorizontalAlignment="Left" Margin="0,12,0,14" />
                    <TextBlock Text="Enter executable names separated by commas. The first match applies. Unmatched apps restore the manual profile." Foreground="#98AABC" TextWrapping="Wrap" />
                    <TextBlock Text="Exports include layout settings and app rules, excluding live audio levels. Imports add profiles without overwriting existing layouts." Foreground="#8095A5" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" />
                  </StackPanel>
                </Expander>
                <Button Content="Restore defaults" Tag="Profiles" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                <TextBlock Text="Disables automatic switching and clears this profile’s app rules. Preserves layouts." Foreground="#8095A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="PlacementPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Placement" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Set the display, screen edge, and wheel spacing." Foreground="#98AABC" Margin="0,12,0,24" TextWrapping="Wrap" />
                <Expander Header="Screen and edge" IsExpanded="True" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="SCREEN EDGE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Edges}" SelectedItem="{Binding ScreenEdge,Mode=TwoWay}" AutomationProperties.Name="Screen edge" />
                    <TextBlock Text="DISPLAY" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <ComboBox x:Name="MonitorBox" ItemsSource="{Binding Monitors}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding MonitorId,Mode=OneWay}" SelectionChanged="MonitorSelected" DropDownClosed="MonitorClosed" AutomationProperties.Name="Display" />
                  </StackPanel>
                </Expander>
                <Expander Header="Position and spacing" IsExpanded="True" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="POSITION ALONG EDGE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding PositionPercent}" TickFrequency="5" IsSnapToTickEnabled="True" AutomationProperties.Name="Position along edge" />
                    <TextBlock Text="Start  ←  Center  →  End" Foreground="#98AABC" FontSize="11" Margin="0,8,0,12" TextWrapping="Wrap" />
                    <TextBlock Text="DISTANCE FROM SCREEN EDGE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Slider x:Name="EdgeDistanceSlider" Minimum="0" Maximum="200" Value="{Binding EdgeDistance}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Distance from screen edge" />
                    <TextBlock Text="{Binding EdgeDistance,StringFormat={}{0} px}" Foreground="#98AABC" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <TextBlock Text="SPACE BETWEEN WHEELS" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <Slider Minimum="0" Maximum="36" Value="{Binding WheelSpacing}" TickFrequency="2" IsSnapToTickEnabled="True" AutomationProperties.Name="Wheel spacing" />
                    <TextBlock Text="{Binding WheelSpacing,StringFormat={}{0} px}" Foreground="#98AABC" Margin="0,8,0,16" TextWrapping="Wrap" />
                    <Button Content="Preview placement" Click="Preview" HorizontalAlignment="Left" />
                    <TextBlock Text="Edge scrolling opens the controls. Scroll over a wheel to adjust volume." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,18,0,0" />
                  </StackPanel>
                </Expander>
                <Button Content="Restore defaults" Tag="Placement" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                <TextBlock Text="Resets display, edge, position, distance, and spacing." Foreground="#8095A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="UpdatesPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Updates" FontSize="26" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AppVersion,StringFormat=Current version: {0}}" Foreground="#98AABC" Margin="0,8,0,24" />
                <Border Background="#151E29" CornerRadius="12" Padding="24">
                  <StackPanel>
                    <TextBlock Text="{Binding UpdateStatus}" FontSize="20" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UpdateDownloadProgress" Value="{Binding UpdateProgress,Mode=OneWay}" Maximum="100" Height="5" Margin="0,20,0,16">
                      <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding InstallingUpdate}" Value="True">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ProgressBar.Style>
                    </ProgressBar>
                    <WrapPanel Margin="0,16,0,0">
                      <Button x:Name="InstallUpdateButton" Content="Download and install" Click="InstallUpdate" IsEnabled="{Binding CanInstallUpdate}" Background="#73DCC8" Foreground="#10231F">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding CanInstallUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates" IsEnabled="{Binding CanCheckUpdates}" />
                      <Button x:Name="CancelUpdateButton" Content="Cancel download" Click="CancelUpdate" IsEnabled="{Binding InstallingUpdate}">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding InstallingUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </WrapPanel>
                    <TextBlock Text="Updates restart WaveWheels and preserve your settings." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,16,0,0" />
                  </StackPanel>
                </Border>
                <Expander Header="Update preferences" Margin="0,16,0,0">
                  <StackPanel Margin="16">
                    <TextBlock Text="Release channel" />
                    <ComboBox x:Name="UpdateChannelPicker" ItemsSource="{Binding UpdateChannels}" SelectedItem="{Binding UpdateChannel}" IsEnabled="{Binding CanCheckUpdates}" Margin="0,8,0,16" />
                    <TextBlock Text="Stable is recommended. Beta includes preview builds." Foreground="#98AABC" />
                    <CheckBox Content="Notify me about updates" Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdatesAutomatically}" Margin="0,20,0,0" />
                  </StackPanel>
                </Expander>
                <Expander Header="Versions and recovery" Margin="0,12,0,0">
                  <StackPanel Margin="16">
                    <TextBlock Text="Latest stable" FontSize="17" />
                    <TextBlock Text="{Binding StableReleaseLabel}" Foreground="#98AABC" Margin="0,8,0,12" />
                    <Button x:Name="InstallStableButton" Content="Install latest stable" Click="InstallStable" IsEnabled="{Binding CanInstallStable}" HorizontalAlignment="Left" />
                    <TextBlock Text="Switches to Stable, including when its version is lower." Foreground="#98AABC" Margin="0,10,0,24" TextWrapping="Wrap" />
                    <TextBlock Text="Beta builds" FontSize="17" />
                    <TextBlock Text="Select the Beta channel to install a preview or an older beta." Foreground="#98AABC" Margin="0,8,0,12" TextWrapping="Wrap" />
                    <ListBox x:Name="BetaBuildList" ItemsSource="{Binding BetaBuilds}" SelectedItem="{Binding SelectedBetaBuild}" Height="150" DisplayMemberPath="Version" Background="#101820" Foreground="#E9F0F5" IsEnabled="{Binding BetaChannelEnabled}" />
                    <WrapPanel Margin="0,12,0,0">
                      <Button x:Name="InstallBetaButton" Content="Install selected beta" Click="InstallBeta" IsEnabled="{Binding CanInstallBeta}" />
                      <Button Content="Release details" Click="OpenBetaRelease" />
                    </WrapPanel>
                  </StackPanel>
                </Expander>
                <Button Content="Open release page" Click="OpenRelease" HorizontalAlignment="Left" Margin="0,20,0,0" />
                <Button Content="Restore defaults" Click="RestoreDefaults" Tag="Updates" HorizontalAlignment="Left" Margin="0,12,0,0" />
              </StackPanel>
            </ScrollViewer>
            <StackPanel x:Name="StartupPage" Visibility="Collapsed">
              <TextBlock Text="Startup" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="Control automatic launch at Windows sign-in." Foreground="#98AABC" Margin="0,10,0,30" TextWrapping="Wrap" />
              <Border Background="#151E29" BorderBrush="#3A2E43" BorderThickness="1" CornerRadius="14" Padding="18">
                <StackPanel>
                  <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupEnabled}" Content="Start at Windows sign-in" AutomationProperties.Name="Start with Windows" />
                  <TextBlock Text="{Binding StartupDescription}" Foreground="#98AABC" TextWrapping="Wrap" Margin="58,12,0,0" />
                </StackPanel>
              </Border>
              <TextBlock Text="The app starts in the system tray. Click its icon to open configuration." Foreground="#8095A5" TextWrapping="Wrap" Margin="0,26,0,0" />
              <Button Content="Restore defaults" Tag="Startup" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
              <TextBlock Text="Disables launch at sign-in." Foreground="#8095A5" TextWrapping="Wrap" />
            </StackPanel>
            <ScrollViewer x:Name="ConnectionPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="Connection" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Manage the local Wave Link connection." Foreground="#98AABC" Margin="0,10,0,30" TextWrapping="Wrap" />
                <Border Background="#151E29" BorderBrush="#3A2E43" BorderThickness="1" CornerRadius="14" Padding="18">
                  <StackPanel>
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ChannelCount}" Foreground="#98AABC" Margin="0,10,0,22" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding WindowsAudioStatus}" Foreground="#F4B16F" TextWrapping="Wrap" Margin="0,0,0,16" />
                    <WrapPanel>
                      <Button x:Name="StartWaveLinkButton" Content="Find and start Wave Link" Click="FindAndStartWaveLink" />
                      <Button Content="Locate Wave Link…" Click="LocateWaveLink" />
                    </WrapPanel>
                    <TextBlock Text="Finds desktop and Store installations. Select WaveLink.exe manually if needed." Foreground="#98AABC" TextWrapping="Wrap" Margin="0,8,0,18" />
                    <Button Content="Reconnect Wave Link" HorizontalAlignment="Left" Click="Reconnect" Background="#73DCC8" Foreground="#10231F" />
                  </StackPanel>
                </Border>
                <Expander Header="Advanced connection settings" IsExpanded="False" Margin="0,0,0,12">
                  <StackPanel Margin="16,4,16,16">
                    <TextBlock Text="LOCAL PORT OVERRIDE" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox Text="{Binding PortText,UpdateSourceTrigger=PropertyChanged}" MaxLength="5" AutomationProperties.Name="Local port override" />
                    <TextBlock Text="Leave blank for automatic discovery." Foreground="#8095A5" FontSize="12" Margin="0,10,0,20" TextWrapping="Wrap" />
                  </StackPanel>
                </Expander>
                <TextBlock Text="Windows Audio is used while disconnected. Your saved channel wheels return on connection. Volume and mute stay independent." Foreground="#8095A5" TextWrapping="Wrap" Margin="0,26,0,0" />
                <Button Content="Restore defaults" Tag="Connection" Click="RestoreDefaults" HorizontalAlignment="Left" Margin="0,24,0,8" />
                <TextBlock Text="Restores automatic port discovery and reconnects." Foreground="#8095A5" TextWrapping="Wrap" />
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </DockPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="#24323F" BorderThickness="0,1,0,0" Background="#0D0E14">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Message}" Foreground="#786D87" FontSize="10" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,18,0" ToolTip="{Binding Message}" TextWrapping="Wrap" />
          <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Foreground="#9A84AC" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>