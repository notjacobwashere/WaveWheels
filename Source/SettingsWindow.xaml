    <StackPanel x:Name="StartupPage" Visibility="Collapsed"><TextBlock Text="Quietly ready." FontSize="31" FontWeight="SemiBold"/><TextBlock Text="Launch with Windows. Keep your desktop clear." Foreground="#898093" Margin="0,10,0,30"/><Border Background="#1B1822" BorderBrush="#3A2E43" BorderThickness="1" CornerRadius="14" Padding="24"><StackPanel><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding StartupEnabled}" Content="Start at Windows sign-in" AutomationProperties.Name="Start with Windows"/><TextBlock Text="{Binding StartupDescription}" Foreground="#998AA7" TextWrapping="Wrap" Margin="58,12,0,0"/></StackPanel></Border><Border Background="#17171F" BorderBrush="#302A39" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EdgeEnabled}" Content="Enable edge scrolling" AutomationProperties.Name="Enable edge scrolling"/><TextBlock Text="Scroll to reveal. Let the scroll stop, then adjust. Choose your edge and display on the Placement page." Foreground="#998AA7" TextWrapping="Wrap" Margin="58,12,0,0"/></StackPanel></Border><TextBlock Text="Configuration stays closed on launch. Use the tray icon to return here." Foreground="#82738F" TextWrapping="Wrap" Margin="0,26,0,0"/></StackPanel>
