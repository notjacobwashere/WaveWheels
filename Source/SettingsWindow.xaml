    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,16,0"><TextBlock Text="MAKE IT YOURS" Foreground="#B393CA" FontSize="9" FontWeight="SemiBold"/><TextBlock Text="Settings." FontSize="31" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock Text="Set your wheel size and how your controls move." Foreground="#898093" Margin="0,0,0,30"/>
