<Application x:Class="WaveWheels.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WaveWheels" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <SolidColorBrush x:Key="Ink" Color="#EAF0F7"/><SolidColorBrush x:Key="Muted" Color="#9CABC0"/>

  <Style TargetType="Button"><Setter Property="local:InterfaceMotion.PressFeedback" Value="True"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="Background" Value="#1C2D39"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid Background="Transparent"><Border x:Name="Frame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#182638"/><Setter Property="Background" Value="#F1F5FA"/><Setter Property="BorderBrush" Value="#D0DAE6"/><Setter Property="FontSize" Value="14"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Foreground" Value="#182638"/><Setter Property="FontSize" Value="14"/><Setter Property="MinHeight" Value="34"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Application.Resources>
</Application>
